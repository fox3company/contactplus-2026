---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import { isPublicPerson } from '../../../lib/content';
import {
  getLocalizedDateLabel,
  getLocalizedDayName,
  getLocalizedDayRangeLabel,
  getLocalizedDayTheme,
} from '../../../lib/festivalDates';
import { getLocalized, getLocalizedCountryDisplay, isLocale } from '../../../lib/locales';
import { locations } from '../../../lib/locations';
import {
  filterProgramEvents,
  getProgramCategoryLabel,
  getProgramFilterGroup,
  getProgramOccurrences,
  groupProgramEventsByDay,
  isPublicDetailEvent,
  isVisibleInProgramView,
  type ProgramFilterGroup,
} from '../../../lib/program';

export async function getStaticPaths() {
  return ['en', 'ro', 'ru'].map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
if (!isLocale(lang)) {
  return Astro.redirect('/en/schedule/horizontal');
}

const allEvents = filterProgramEvents(await getCollection('events'), {
  viewMode: 'full_festival',
  includeScheduleOnly: true,
});
const dayGroups = groupProgramEventsByDay(allEvents);
const allPeople = await getCollection('people');
const peopleById = new Map(allPeople.map((person) => [person.data.id || person.slug, person]));

const timeBands = [
  { key: 'morning', label: { en: 'Morning', ro: 'Dimineață', ru: 'Утро' }, range: 'Before 10:00', start: 0, end: 600 },
  { key: 'late-morning', label: { en: 'Late morning', ro: 'Dimineață târziu', ru: 'Позднее утро' }, range: '10:00 — 13:30', start: 600, end: 810 },
  { key: 'afternoon', label: { en: 'Afternoon', ro: 'După-amiază', ru: 'День' }, range: '13:30 — 18:30', start: 810, end: 1110 },
  { key: 'evening', label: { en: 'Evening', ro: 'Seară', ru: 'Вечер' }, range: '18:30 — 21:30', start: 1110, end: 1290 },
  { key: 'late-evening', label: { en: 'Late evening', ro: 'Seară târziu', ru: 'Поздний вечер' }, range: 'After 21:30', start: 1290, end: 1600 },
];

const pageTitle = getLocalized({ en: 'Horizontal Schedule', ro: 'Orar orizontal', ru: 'Горизонтальное расписание' }, lang);
const intro = getLocalized({
  en: 'A wide overview of the festival composition across days and time bands.',
  ro: 'O vedere largă asupra compoziției festivalului pe zile și intervale de timp.',
  ru: 'Широкий обзор композиции фестиваля по дням и временным блокам.',
}, lang);
const labels = {
  vertical: getLocalized({ en: 'Vertical', ro: 'Vertical', ru: 'Вертикально' }, lang),
  horizontal: getLocalized({ en: 'Horizontal', ro: 'Orizontal', ru: 'Горизонтально' }, lang),
  full: getLocalized({ en: 'Full festival', ro: 'Festival complet', ru: 'Весь фестиваль' }, lang),
  classes: getLocalized({ en: 'Classes & performances only', ro: 'Doar clase și performance-uri', ru: 'Только классы и перформансы' }, lang),
  all: getLocalized({ en: 'All', ro: 'Toate', ru: 'Все' }, lang),
  ci: getLocalized({ en: 'CI', ro: 'Improvizație de contact', ru: 'КИ' }, lang),
  performanceLabs: getLocalized({ en: 'Perf Labs', ro: 'Perf Labs', ru: 'Перформанс-лабы' }, lang),
  family: getLocalized({ en: 'Family & Youth', ro: 'Familie și copii', ru: 'Семья и дети' }, lang),
  performances: getLocalized({ en: 'Perf', ro: 'Perf', ru: 'Перформансы' }, lang),
  jams: getLocalized({ en: 'Jams & gatherings', ro: 'Jam-uri și întâlniri', ru: 'Джемы и встречи' }, lang),
  breaks: getLocalized({ en: 'Breaks', ro: 'Pauze', ru: 'Паузы' }, lang),
  focus: getLocalized({ en: 'Focus', ro: 'Focus', ru: 'Фокус' }, lang),
  mode: getLocalized({ en: 'Mode', ro: 'Mod', ru: 'Режим' }, lang),
  view: getLocalized({ en: 'View', ro: 'Vedere', ru: 'Вид' }, lang),
  close: getLocalized({ en: 'Close', ro: 'Închide', ru: 'Закрыть' }, lang),
  date: getLocalized({ en: 'Date', ro: 'Dată', ru: 'Дата' }, lang),
  time: getLocalized({ en: 'Time', ro: 'Oră', ru: 'Время' }, lang),
  place: getLocalized({ en: 'Place', ro: 'Loc', ru: 'Место' }, lang),
  with: getLocalized({ en: 'With', ro: 'Cu', ru: 'С кем' }, lang),
  by: getLocalized({ en: 'By', ro: 'De', ru: 'От' }, lang),
  fullPage: getLocalized({ en: 'Open full event page', ro: 'Deschide pagina completă', ru: 'Открыть полную страницу' }, lang),
  openDetails: getLocalized({ en: 'Open details', ro: 'Deschide detalii', ru: 'Открыть подробности' }, lang),
  empty: getLocalized({ en: 'No events in this view.', ro: 'Nu există evenimente în această vedere.', ru: 'В этом виде нет событий.' }, lang),
  more: getLocalized({ en: 'more', ro: 'în plus', ru: 'ещё' }, lang),
  parallel: getLocalized({ en: 'Parallel', ro: 'Paralel', ru: 'Параллельно' }, lang),
  sequence: getLocalized({ en: 'Sequence', ro: 'Secvență', ru: 'Последовательно' }, lang),
  closingFlow: getLocalized({ en: 'Closing flow', ro: 'Flux de închidere', ru: 'Финальный поток' }, lang),
  festivalContext: getLocalized({
    en: 'Sep 26 — Oct 4 · Chișinău',
    ro: '26 sept — 4 oct · Chișinău',
    ru: '26 сентября — 4 октября · Кишинёв',
  }, lang),
};

function getMinutes(timeDisplay: string) {
  if (timeDisplay === 'Daytime') return 810;
  const match = timeDisplay.match(/\b(\d{1,2}):(\d{2})\b/);
  if (!match) return 1439;
  return Number(match[1]) * 60 + Number(match[2]);
}

function getBandKey(timeDisplay: string) {
  const minutes = getMinutes(timeDisplay);
  return timeBands.find((band) => minutes >= band.start && minutes < band.end)?.key || 'late-evening';
}

function getPersonLabel(person: { public_label?: Partial<Record<typeof lang, string>> }, eventPeopleLabel?: string) {
  return getLocalized(person.public_label, lang)
    || (eventPeopleLabel === 'By' ? labels.by : labels.with);
}

function formatPersonName(personId: string) {
  return peopleById.get(personId)?.data.name || personId.split('-').map((part) => part.charAt(0).toUpperCase() + part.slice(1)).join(' ');
}

function formatPersonCountry(personId: string) {
  return getLocalizedCountryDisplay(peopleById.get(personId)?.data.country_display, lang);
}

function getEventDetailKey(eventSlug: string, occurrenceDate: string, occurrenceDateLabel: string) {
  return `${eventSlug}--${occurrenceDate || occurrenceDateLabel.toLowerCase().replace(/\s+/g, '-')}`;
}

function getDayRangeLabel(dateLabel: string) {
  return getLocalizedDayRangeLabel(dateLabel, lang);
}

function getEventDateLines(event: typeof allEvents[number]) {
  return event.data.schedule.date_display
    .split(/,\s*(?=[A-Z][a-z]{2}\s+\d)/)
    .filter(Boolean)
    .map(getDayRangeLabel);
}

function getOccurrenceLocationFacts(event: typeof allEvents[number]) {
  const grouped = new Map<string, { dateLabels: string[]; name: string; address: string; href: string }>();

  getProgramOccurrences([event]).forEach((occurrence) => {
    const locationRef = occurrence.locationRef || event.data.location_ref;
    if (!locationRef) return;
    const location = locations[locationRef];
    const fact = grouped.get(locationRef) || {
      dateLabels: [],
      name: location?.name || locationRef,
      address: location?.address || '',
      href: location?.href || '',
    };

    if (occurrence.dateLabel && !fact.dateLabels.includes(occurrence.dateLabel)) {
      fact.dateLabels.push(occurrence.dateLabel);
    }

    grouped.set(locationRef, fact);
  });

  return [...grouped.values()].map((fact) => ({
    ...fact,
    dateLabel: fact.dateLabels.join(' — '),
    localizedDateLabel: getLocalizedDateLabel(fact.dateLabels.join(' — '), lang),
  }));
}

function getCellOccurrences(day: string, bandKey: string) {
  const dayGroup = dayGroups.find((group) => group.day === day);
  if (!dayGroup) return [];
  return dayGroup.occurrences.filter((occurrence) => getBandKey(occurrence.timeDisplay) === bandKey);
}

function isSequentialPerformanceGroup(occurrences: ReturnType<typeof getCellOccurrences>) {
  return occurrences.length > 1 && occurrences.every((occurrence) => getProgramFilterGroup(occurrence.event) === 'performances');
}

function getCellOccurrenceGroups(day: string, bandKey: string) {
  const groups = new Map<string, ReturnType<typeof getCellOccurrences>>();

  for (const occurrence of getCellOccurrences(day, bandKey)) {
    const groupKey = occurrence.timeDisplay || occurrence.event.data.schedule.time_display;
    groups.set(groupKey, [...(groups.get(groupKey) || []), occurrence]);
  }

  return [...groups.entries()].map(([timeDisplay, occurrences]) => {
    const isClosingFlow = day === 'Oct 4' && (timeDisplay === 'Daytime' || timeDisplay === 'Afterwards');
    const groupType = isClosingFlow
      ? 'closing'
      : isSequentialPerformanceGroup(occurrences)
        ? 'sequence'
        : occurrences.length > 1
          ? 'parallel'
          : 'single';

    return {
      timeDisplay,
      occurrences,
      groupType,
    };
  });
}

function getDayOccurrenceGroups(day: string) {
  const dayGroup = dayGroups.find((group) => group.day === day);
  if (!dayGroup) return [];
  const groups = new Map<string, typeof dayGroup.occurrences>();

  for (const occurrence of dayGroup.occurrences) {
    const groupKey = occurrence.timeDisplay || occurrence.event.data.schedule.time_display;
    groups.set(groupKey, [...(groups.get(groupKey) || []), occurrence]);
  }

  return [...groups.entries()].map(([timeDisplay, occurrences]) => ({
    timeDisplay,
    occurrences,
    groupType: day === 'Oct 4' && (timeDisplay === 'Daytime' || timeDisplay === 'Afterwards')
      ? 'closing'
      : isSequentialPerformanceGroup(occurrences)
        ? 'sequence'
        : occurrences.length > 1
          ? 'parallel'
          : 'single',
  }));
}

function getCompactCardNote(event: typeof allEvents[number], summary: string) {
  if (event.slug === 'youth-dance-class') {
    return getLocalized({
      en: 'Play, coordination and imagination.',
      ro: 'Joc, coordonare și imaginație.',
      ru: 'Игра, координация и воображение.',
    }, lang);
  }

  if (event.slug === 'performative-space') {
    return getLocalized({
      en: 'Open platform for short artistic encounters.',
      ro: 'Platformă deschisă pentru întâlniri artistice scurte.',
      ru: 'Открытая платформа для коротких художественных встреч.',
    }, lang);
  }

  return event.data.visibility === 'schedule_only' ? summary : '';
}

const filterLabels: { key: ProgramFilterGroup; label: string }[] = [
  { key: 'all', label: labels.all },
  { key: 'ci', label: labels.ci },
  { key: 'performance_labs', label: labels.performanceLabs },
  { key: 'family_youth', label: labels.family },
  { key: 'performances', label: labels.performances },
  { key: 'jams_gatherings', label: labels.jams },
  { key: 'breaks', label: labels.breaks },
];

const eventDetails = Object.fromEntries(dayGroups.flatMap(({ occurrences }) => (
  occurrences.map(({ event, date, dateLabel, timeDisplay, locationRef }) => {
    const visiblePeople = (event.data.people || []).filter((person) => person.public_visibility === 'visible');
    const people = visiblePeople.map((person) => {
      const profile = peopleById.get(person.person_id);
      return {
        label: getPersonLabel(person, event.data.people_label),
        name: formatPersonName(person.person_id),
        country: getLocalizedCountryDisplay(profile?.data.country_display, lang),
        href: profile && isPublicPerson(profile) ? `/${lang}/artists/${profile.slug}` : '',
      };
    });
    const category = getProgramCategoryLabel(getLocalized(event.data.meta?.category, lang), event.data.program_line);
    const format = getLocalized(event.data.meta?.format, lang);
    const location = locationRef ? locations[locationRef] : undefined;
    const places = getOccurrenceLocationFacts(event);
    const firstPlace = places[0];

    return [
      getEventDetailKey(event.slug, date, dateLabel),
      {
        title: getLocalized(event.data.title, lang),
        category: category || event.data.program_line,
        format,
        dateLines: getEventDateLines(event),
        time: timeDisplay || event.data.schedule.time_display,
        place: firstPlace?.name || location?.name || locationRef || '',
        placeAddress: firstPlace?.address || location?.address || '',
        placeHref: firstPlace?.href || location?.href || '',
        places,
        people,
        description: getLocalized(event.data.body, lang) || getLocalized(event.data.summary, lang),
        focusLabel: getLocalized(event.data.focus_label, lang),
        focus: getLocalized(event.data.focus, lang),
        fullPageHref: isPublicDetailEvent(event) ? `/${lang}/program/${event.slug}` : '',
      },
    ];
  })
)));
---

<BaseLayout lang={lang} title={`${pageTitle} · Contact+ 2026`} description={intro}>
  <main class="horizontal-page">
    <PageHero title={pageTitle} description={intro} context={labels.festivalContext} />

    <section class="horizontal-controls" aria-label={pageTitle}>
      <div class="control-row">
        <span>{labels.view}</span>
        <a href={`/${lang}/schedule`}>{labels.vertical}</a>
        <a class="active" href={`/${lang}/schedule/horizontal`}>{labels.horizontal}</a>
      </div>
      <div class="control-row" data-mode-controls>
        <span>{labels.mode}</span>
        <button class="active" type="button" data-view-mode="full_festival">{labels.full}</button>
        <button type="button" data-view-mode="classes_performances">{labels.classes}</button>
      </div>
      <div class="control-row" data-filter-controls>
        <span>{labels.focus}</span>
        {filterLabels.map((filter) => (
          <button class={filter.key === 'all' ? 'active' : ''} type="button" data-filter={filter.key}>
            {filter.label}<span class="filter-x" aria-hidden="true">×</span>
          </button>
        ))}
      </div>
    </section>

    <section class="horizontal-board" aria-label={pageTitle}>
      <div class="schedule-grid">
        <div class="grid-corner">Time</div>
        {dayGroups.map(({ day }) => (
          <div class="grid-day">
            <p>{getLocalizedDayName(day, lang)}</p>
            <h2>{getLocalizedDateLabel(day, lang)}</h2>
            <span>{getLocalizedDayTheme(day, lang)}</span>
          </div>
        ))}

        {timeBands.map((band, bandIndex) => (
          <>
            <div class="grid-time">
              <strong>{getLocalized(band.label, lang)}</strong>
              <span>{band.range}</span>
            </div>
            {dayGroups.map(({ day }) => {
              if (day === 'Oct 4' && bandIndex > 0) return null;
              const occurrenceGroups = day === 'Oct 4' ? getDayOccurrenceGroups(day) : getCellOccurrenceGroups(day, band.key);
              return (
                <div
                  class={`grid-cell ${occurrenceGroups.length ? '' : 'grid-cell--empty'} ${day === 'Oct 4' ? 'grid-cell--closing-day grid-cell--closing-merged' : ''}`}
                  data-grid-cell
                >
                  {day === 'Oct 4' && <p class="closing-day-title">{labels.closingFlow}</p>}
                  {occurrenceGroups.map(({ timeDisplay, occurrences, groupType }) => (
                    <div class={`horizontal-time-group horizontal-time-group--${groupType}`} data-time-group>
                      <div class="horizontal-time-group__head">
                        <span>{timeDisplay}</span>
                        {groupType === 'parallel' && <em>{labels.parallel}</em>}
                      </div>
                      <div class="horizontal-time-group__cards">
                        {occurrences.map(({ event, date, dateLabel }) => {
                          const category = getProgramCategoryLabel(getLocalized(event.data.meta?.category, lang), event.data.program_line) || event.data.program_line;
                          const format = getLocalized(event.data.meta?.format, lang);
                          const title = getLocalized(event.data.title, lang);
                          const summary = getLocalized(event.data.summary, lang);
                          const compactNote = getCompactCardNote(event, summary);
                          const filterGroup = getProgramFilterGroup(event);
                          const detailKey = getEventDetailKey(event.slug, date, dateLabel);
                          const visiblePeople = (event.data.people || []).filter((person) => person.public_visibility === 'visible');
                          const compactPeople = event.slug === 'choice-as-bodily-experience'
                            ? visiblePeople.filter((person) => !['alexandra-soshnicova', 'sergey-golovnea'].includes(person.person_id)).slice(0, 2)
                            : visiblePeople.slice(0, 2);
                          const cardPeople = compactPeople.map((person) => ({
                            name: formatPersonName(person.person_id),
                            country: formatPersonCountry(person.person_id),
                          }));
                          const hiddenPeopleCount = Math.max(0, visiblePeople.length - cardPeople.length);
                          const isSecondary = filterGroup === 'breaks' || filterGroup === 'org';

                          return (
                            <article
                              class={`horizontal-card horizontal-card--${filterGroup}`}
                              data-horizontal-card
                              data-filter-group={filterGroup}
                              data-card-kind={event.data.visibility === 'schedule_only' ? 'schedule-only' : 'detail'}
                              data-card-note={compactNote ? 'true' : 'false'}
                              data-density={isSecondary ? 'secondary' : 'primary'}
                              data-view-classes={isVisibleInProgramView(event, 'classes_performances') ? 'true' : 'false'}
                              data-detail-key={detailKey}
                              role="button"
                              tabindex="0"
                              aria-label={`${labels.openDetails}: ${title}`}
                            >
                              <p class="horizontal-card__meta">
                                <span class="horizontal-card__meta-primary">{category}</span>
                                {format && <span class="horizontal-card__meta-secondary">{format}</span>}
                              </p>
                              <h3>{title}</h3>
                              {cardPeople.length > 0 && (
                                <span class="horizontal-card__people" aria-label={cardPeople.map((person) => person.name).join(', ')}>
                                  {cardPeople.map((person) => (
                                    <span class="horizontal-card__person">
                                      <span>{person.name}</span>
                                      {person.country && <small>{person.country}</small>}
                                    </span>
                                  ))}
                                  {hiddenPeopleCount > 0 && (
                                    <span class="horizontal-card__person horizontal-card__person--more">
                                      +{hiddenPeopleCount} {labels.more}
                                    </span>
                                  )}
                                </span>
                              )}
                              {!cardPeople.length && compactNote && <p class="horizontal-card__summary">{compactNote}</p>}
                            </article>
                          );
                        })}
                      </div>
                    </div>
                  ))}
                </div>
              );
            })}
          </>
        ))}
      </div>
      <p class="empty-message" data-empty-message hidden>{labels.empty}</p>
    </section>

    <div class="detail-overlay" data-detail-overlay hidden></div>
    <aside class="detail-panel" data-detail-panel aria-hidden="true" aria-modal="true" role="dialog" aria-labelledby="horizontal-detail-title">
      <button class="detail-close" type="button" data-detail-close aria-label={labels.close}>×</button>
      <p class="program-meta detail-kicker">
        <span class="program-meta__category" data-detail-category></span>
        <span class="program-meta__divider" data-detail-format-divider aria-hidden="true"></span>
        <span class="program-meta__format" data-detail-format></span>
      </p>
      <h2 id="horizontal-detail-title" data-detail-title></h2>
      <dl class="detail-facts">
        <div class="detail-fact">
          <dt>{labels.date}</dt>
          <dd data-detail-date></dd>
        </div>
        <div class="detail-fact">
          <dt>{labels.time}</dt>
          <dd data-detail-time></dd>
        </div>
        <div class="detail-fact detail-fact--wide" data-detail-place-wrap>
          <dt>{labels.place}</dt>
          <dd data-detail-place-list>
            <a class="detail-place-link" href="#" data-detail-place-link rel="noopener" target="_blank">
              <span data-detail-place></span>
              <small data-detail-place-address></small>
            </a>
          </dd>
        </div>
        <div class="detail-fact detail-fact--wide detail-people" data-detail-people-wrap>
          <dt data-detail-people-label>{labels.with}</dt>
          <dd data-detail-people></dd>
        </div>
      </dl>
      <div class="detail-description" data-detail-description></div>
      <section class="detail-focus" data-detail-focus-wrap hidden>
        <h3 data-detail-focus-label></h3>
        <p data-detail-focus></p>
      </section>
      <a class="detail-full-link" href="#" data-detail-full-page>{labels.fullPage}</a>
    </aside>
  </main>
</BaseLayout>

<script type="application/json" id="horizontal-detail-data" set:html={JSON.stringify(eventDetails)}></script>

<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    const cards = [...document.querySelectorAll('[data-horizontal-card]')];
    const cells = [...document.querySelectorAll('[data-grid-cell]')];
    const timeGroups = [...document.querySelectorAll('[data-time-group]')];
    const filterButtons = [...document.querySelectorAll('[data-filter]')];
    const viewButtons = [...document.querySelectorAll('[data-view-mode]')];
    const emptyMessage = document.querySelector('[data-empty-message]');
    const detailData = JSON.parse(document.getElementById('horizontal-detail-data')?.textContent || '{}');
    const detailOverlay = document.querySelector('[data-detail-overlay]');
    const detailPanel = document.querySelector('[data-detail-panel]');
    const detailClose = document.querySelector('[data-detail-close]');
    const detailFullPage = document.querySelector('[data-detail-full-page]');
    let activeViewMode = 'full_festival';
    let activeFilters = new Set(['all']);
    let lastFocusedCard = null;

    function setText(selector, value) {
      const element = document.querySelector(selector);
      if (element) element.textContent = value || '';
    }

    function passesFilters(card) {
      const filterGroup = card.getAttribute('data-filter-group');
      const viewMatch = activeViewMode === 'full_festival' || card.getAttribute('data-view-classes') === 'true';
      const filterMatch = activeFilters.has('all') || activeFilters.has(filterGroup);
      return viewMatch && filterMatch;
    }

    function renderBoard() {
      let visibleCount = 0;
      cards.forEach((card) => {
        const visible = passesFilters(card);
        card.classList.toggle('is-hidden', !visible);
        if (visible) visibleCount += 1;
      });
      timeGroups.forEach((group) => {
        const visibleCards = [...group.querySelectorAll('[data-horizontal-card]')].filter((card) => !card.classList.contains('is-hidden'));
        group.classList.toggle('is-hidden', visibleCards.length === 0);
      });
      cells.forEach((cell) => {
        const visibleCards = [...cell.querySelectorAll('[data-horizontal-card]')].filter((card) => !card.classList.contains('is-hidden'));
        cell.classList.toggle('grid-cell--filtered-empty', visibleCards.length === 0 && !cell.classList.contains('grid-cell--empty'));
      });
      filterButtons.forEach((button) => {
        const filter = button.getAttribute('data-filter');
        button.classList.toggle('active', activeFilters.has(filter));
      });
      viewButtons.forEach((button) => {
        button.classList.toggle('active', button.getAttribute('data-view-mode') === activeViewMode);
      });
      if (emptyMessage) emptyMessage.hidden = visibleCount > 0;
    }

    function openDetail(key, trigger) {
      const data = detailData[key];
      if (!data || !detailPanel || !detailOverlay) return;
      lastFocusedCard = trigger;
      detailPanel.setAttribute('data-accent', trigger?.getAttribute('data-filter-group') || '');
      setText('[data-detail-category]', data.category);
      setText('[data-detail-format]', data.format);
      const formatDivider = document.querySelector('[data-detail-format-divider]');
      const formatLabel = document.querySelector('[data-detail-format]');
      if (formatDivider) formatDivider.hidden = !data.format;
      if (formatLabel) formatLabel.hidden = !data.format;
      setText('[data-detail-title]', data.title);
      setText('[data-detail-time]', data.time);
      setText('[data-detail-place]', data.place);
      setText('[data-detail-place-address]', data.placeAddress);
      setText('[data-detail-description]', data.description);

      const dateList = document.querySelector('[data-detail-date]');
      if (dateList) {
        dateList.innerHTML = '';
        (data.dateLines || []).forEach((dateLine) => {
          const item = document.createElement('span');
          item.className = 'detail-date-line';
          const [dateValue, dayValue] = dateLine.split(' · ');
          const dateText = document.createElement('span');
          dateText.className = 'detail-date-value';
          dateText.textContent = dateValue;
          item.appendChild(dateText);
          if (dayValue) {
            const dayText = document.createElement('span');
            dayText.className = 'detail-date-days';
            dayText.textContent = ` · ${dayValue}`;
            item.appendChild(dayText);
          }
          dateList.appendChild(item);
        });
      }

      const placeWrap = document.querySelector('[data-detail-place-wrap]');
      const placeList = document.querySelector('[data-detail-place-list]');
      const places = data.places?.length ? data.places : (data.place ? [{
        name: data.place,
        address: data.placeAddress,
        href: data.placeHref,
        localizedDateLabel: '',
      }] : []);
      if (placeWrap) placeWrap.hidden = !places.length;
      if (placeList) {
        placeList.innerHTML = '';
        places.forEach((place) => {
          const placeElement = place.href ? document.createElement('a') : document.createElement('span');
          placeElement.className = 'detail-place-link';
          if (place.href) {
            placeElement.setAttribute('href', place.href);
            placeElement.setAttribute('rel', 'noopener');
            placeElement.setAttribute('target', '_blank');
          }

          if ((place.localizedDateLabel || place.dateLabel) && places.length > 1) {
            const date = document.createElement('small');
            date.className = 'detail-place-date';
            date.textContent = place.localizedDateLabel || place.dateLabel;
            placeElement.appendChild(date);
          }

          const name = document.createElement('span');
          name.textContent = place.name;
          placeElement.appendChild(name);

          if (place.address) {
            const address = document.createElement('small');
            address.textContent = place.address;
            placeElement.appendChild(address);
          }

          placeList.appendChild(placeElement);
        });
      }

      const peopleWrap = document.querySelector('[data-detail-people-wrap]');
      const peopleLabel = document.querySelector('[data-detail-people-label]');
      const peopleList = document.querySelector('[data-detail-people]');
      if (peopleWrap && peopleList) {
        peopleWrap.hidden = !data.people?.length;
        peopleList.innerHTML = '';
        if (data.people?.length) {
          if (peopleLabel) peopleLabel.textContent = data.people[0].label || peopleLabel.textContent;
          data.people.forEach((person) => {
            const row = document.createElement('span');
            row.className = 'detail-person-row';
            const nameWrap = person.href ? document.createElement('a') : document.createElement('span');
            nameWrap.className = 'detail-person-name-link';
            if (person.href) nameWrap.setAttribute('href', person.href);
            const name = document.createElement('span');
            name.className = 'detail-person-name';
            name.textContent = person.name;
            nameWrap.appendChild(name);
            row.appendChild(nameWrap);
            if (person.country) {
              const separator = document.createElement('span');
              separator.className = 'detail-person-separator';
              separator.setAttribute('aria-hidden', 'true');
              separator.textContent = ' · ';
              row.appendChild(separator);
              const country = document.createElement('span');
              country.className = 'detail-person-country';
              country.textContent = person.country;
              row.appendChild(country);
            }
            peopleList.appendChild(row);
          });
        }
      }

      const focusWrap = document.querySelector('[data-detail-focus-wrap]');
      if (focusWrap) {
        focusWrap.hidden = !data.focus;
        setText('[data-detail-focus-label]', data.focusLabel);
        setText('[data-detail-focus]', data.focus);
      }

      if (detailFullPage) {
        detailFullPage.hidden = !data.fullPageHref;
        detailFullPage.setAttribute('href', data.fullPageHref || '#');
      }

      detailOverlay.hidden = false;
      detailPanel.classList.add('open');
      detailOverlay.classList.add('open');
      detailPanel.setAttribute('aria-hidden', 'false');
      detailClose?.focus();
    }

    function closeDetail() {
      if (!detailPanel || !detailOverlay) return;
      detailPanel.classList.remove('open');
      detailOverlay.classList.remove('open');
      detailPanel.setAttribute('aria-hidden', 'true');
      detailOverlay.hidden = true;
      lastFocusedCard?.focus?.();
    }

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');
        if (filter === 'all') {
          activeFilters = new Set(['all']);
        } else {
          activeFilters.delete('all');
          activeFilters.has(filter) ? activeFilters.delete(filter) : activeFilters.add(filter);
          if (activeFilters.size === 0) activeFilters.add('all');
        }
        renderBoard();
      });
    });

    viewButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeViewMode = button.getAttribute('data-view-mode') || 'full_festival';
        renderBoard();
      });
    });

    cards.forEach((card) => {
      card.addEventListener('click', () => openDetail(card.getAttribute('data-detail-key'), card));
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openDetail(card.getAttribute('data-detail-key'), card);
        }
      });
    });

    detailClose?.addEventListener('click', closeDetail);
    detailOverlay?.addEventListener('click', closeDetail);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeDetail();
    });
    renderBoard();
  });
</script>

