---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { isPublicPerson } from '../../lib/content';
import {
  getLocalizedDateLabel,
  getLocalizedDayName,
  getLocalizedDayRangeLabel,
  getLocalizedDayTheme,
} from '../../lib/festivalDates';
import { getLocalized, isLocale } from '../../lib/locales';
import { locations } from '../../lib/locations';
import {
  filterProgramEvents,
  getProgramCategoryLabel,
  getProgramFilterGroup,
  getProgramOccurrences,
  groupProgramEventsByDay,
  isPublicDetailEvent,
  isVisibleInProgramView,
} from '../../lib/program';

export async function getStaticPaths() {
  return ['en', 'ro', 'ru'].map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
if (!isLocale(lang)) {
  return Astro.redirect('/en/schedule');
}

const allEvents = filterProgramEvents(await getCollection('events'), {
  viewMode: 'full_festival',
  includeScheduleOnly: true,
});
const dayGroups = groupProgramEventsByDay(allEvents).map((dayGroup) => {
  const timeGroups = new Map<string, typeof dayGroup.occurrences>();

  for (const occurrence of dayGroup.occurrences) {
    timeGroups.set(occurrence.timeDisplay, [...(timeGroups.get(occurrence.timeDisplay) || []), occurrence]);
  }

  return {
    day: dayGroup.day,
    timeGroups: [...timeGroups.entries()].map(([timeDisplay, occurrences]) => ({ timeDisplay, occurrences })),
  };
});
const allPeople = await getCollection('people');
const peopleById = new Map(allPeople.map((person) => [person.data.id || person.slug, person]));

function getDayId(day: string) {
  return `day-${day.toLowerCase().replace(/\s+/g, '-')}`;
}

function isParallelBlock(day: string, timeDisplay: string, occurrences: typeof dayGroups[number]['timeGroups'][number]['occurrences']) {
  if (occurrences.length < 2) return false;
  if (day === 'Oct 4' && timeDisplay === 'Daytime') return false;

  const performanceOnlyLines = new Set(['performance', 'theatre_performance']);
  return !occurrences.every(({ event }) => performanceOnlyLines.has(event.data.program_line));
}

const pageTitle = getLocalized({ en: 'Schedule', ro: 'Orar', ru: 'Расписание' }, lang);
const intro = getLocalized({
  en: 'A practical vertical view of the festival program, organized by days and time.',
  ro: 'O vedere verticală practică a programului festivalului, organizată pe zile și ore.',
  ru: 'Практичный вертикальный вид программы фестиваля: по дням и времени.',
}, lang);

const labels = {
  vertical: getLocalized({ en: 'Vertical', ro: 'Vertical', ru: 'Вертикально' }, lang),
  horizontal: getLocalized({ en: 'Horizontal', ro: 'Orizontal', ru: 'Горизонтально' }, lang),
  full: getLocalized({ en: 'Full festival', ro: 'Festival complet', ru: 'Весь фестиваль' }, lang),
  classes: getLocalized({
    en: 'Classes & performances only',
    ro: 'Doar clase și performance-uri',
    ru: 'Только классы и перформансы',
  }, lang),
  all: getLocalized({ en: 'All', ro: 'Toate', ru: 'Все' }, lang),
  ci: getLocalized({ en: 'CI', ro: 'CI', ru: 'КИ' }, lang),
  performanceLabs: getLocalized({
    en: 'Perf Labs',
    ro: 'Perf Labs',
    ru: 'Перформанс-лабы',
  }, lang),
  family: getLocalized({ en: 'Family & Youth', ro: 'Familie și copii', ru: 'Семья и дети' }, lang),
  performances: getLocalized({ en: 'Perf', ro: 'Perf', ru: 'Перформансы' }, lang),
  jams: getLocalized({ en: 'Jams & gatherings', ro: 'Jam-uri și întâlniri', ru: 'Джемы и встречи' }, lang),
  search: getLocalized({
    en: 'Search program',
    ro: 'Caută în program',
    ru: 'Поиск по программе',
  }, lang),
  searchPlaceholder: getLocalized({
    en: 'Search event, artist, class...',
    ro: 'Caută eveniment, artist, clasă...',
    ru: 'Событие, артист, класс...',
  }, lang),
  view: getLocalized({ en: 'View', ro: 'Vedere', ru: 'Вид' }, lang),
  mode: getLocalized({ en: 'Mode', ro: 'Mod', ru: 'Режим' }, lang),
  filters: getLocalized({ en: 'Focus', ro: 'Focus', ru: 'Фокус' }, lang),
  parallel: getLocalized({
    en: 'Parallel sessions',
    ro: 'Sesiuni paralele',
    ru: 'Параллельные сессии',
  }, lang),
  empty: getLocalized({
    en: 'No events match this view.',
    ro: 'Nu există evenimente pentru această vedere.',
    ru: 'Для этого режима нет событий.',
  }, lang),
  top: getLocalized({ en: 'Top', ro: 'Sus', ru: 'Вверх' }, lang),
  festivalContext: getLocalized({
    en: 'Sep 26 — Oct 4 · Chișinău',
    ro: '26 sept — 4 oct · Chișinău',
    ru: '26 сентября — 4 октября · Кишинёв',
  }, lang),
  openDetails: getLocalized({
    en: 'Open details',
    ro: 'Deschide detalii',
    ru: 'Открыть подробности',
  }, lang),
  close: getLocalized({ en: 'Close', ro: 'Închide', ru: 'Закрыть' }, lang),
  date: getLocalized({ en: 'Date', ro: 'Dată', ru: 'Дата' }, lang),
  time: getLocalized({ en: 'Time', ro: 'Oră', ru: 'Время' }, lang),
  place: getLocalized({ en: 'Place', ro: 'Loc', ru: 'Место' }, lang),
  with: getLocalized({ en: 'With', ro: 'Cu', ru: 'С кем' }, lang),
  by: getLocalized({ en: 'By', ro: 'De', ru: 'От' }, lang),
  fullPage: getLocalized({
    en: 'Open full event page',
    ro: 'Deschide pagina completă',
    ru: 'Открыть полную страницу',
  }, lang),
  view: getLocalized({ en: 'View', ro: 'Vedere', ru: 'Вид' }, lang),
};

function formatPersonName(personId: string) {
  return peopleById.get(personId)?.data.name || personId.split('-').map((part) => part.charAt(0).toUpperCase() + part.slice(1)).join(' ');
}

function getPersonLabel(person: { public_label?: Partial<Record<typeof lang, string>> }, eventPeopleLabel?: string) {
  return getLocalized(person.public_label, lang)
    || (eventPeopleLabel === 'By' ? labels.by : labels.with);
}

function getEventDetailKey(eventSlug: string, occurrenceDate: string, occurrenceDateLabel: string) {
  return `${eventSlug}--${occurrenceDate || occurrenceDateLabel.toLowerCase().replace(/\s+/g, '-')}`;
}

function getDateLine(dateLabel: string) {
  const dayName = getLocalizedDayName(dateLabel, lang);
  return [getLocalizedDateLabel(dateLabel, lang), dayName].filter(Boolean).join(' · ');
}

function getDayRangeLabel(dateLabel: string) {
  return getLocalizedDayRangeLabel(dateLabel, lang);
}

function getEventDateDisplay(event: typeof allEvents[number]) {
  return event.data.schedule.date_display;
}

function getEventDateLines(event: typeof allEvents[number]) {
  return getEventDateDisplay(event)
    .split(/,\s*(?=[A-Z][a-z]{2}\s+\d)/)
    .filter(Boolean)
    .map(getDayRangeLabel);
}

function getOccurrenceLocationFacts(event: typeof allEvents[number]) {
  const grouped = new Map<string, { dateLabels: string[]; name: string; address: string; href: string }>();

  getProgramOccurrences([event]).forEach((occurrence) => {
    const locationRef = occurrence.locationRef || event.data.location_ref;
    if (!locationRef) return;
    const location = locations[locationRef];
    const fact = grouped.get(locationRef) || {
      dateLabels: [],
      name: location?.name || locationRef,
      address: location?.address || '',
      href: location?.href || '',
    };

    if (occurrence.dateLabel && !fact.dateLabels.includes(occurrence.dateLabel)) {
      fact.dateLabels.push(occurrence.dateLabel);
    }

    grouped.set(locationRef, fact);
  });

  return [...grouped.values()].map((fact) => ({
    ...fact,
    dateLabel: fact.dateLabels.join(' — '),
    localizedDateLabel: getLocalizedDateLabel(fact.dateLabels.join(' — '), lang),
  }));
}

const eventDetails = Object.fromEntries(dayGroups.flatMap(({ timeGroups }) => (
  timeGroups.flatMap(({ occurrences }) => (
    occurrences.map(({ event, date, dateLabel, timeDisplay, locationRef: locationRefFromOccurrence }) => {
      const visiblePeople = (event.data.people || []).filter((person) => person.public_visibility === 'visible');
      const people = visiblePeople.map((person) => {
        const profile = peopleById.get(person.person_id);
        return {
          label: getPersonLabel(person, event.data.people_label),
          name: formatPersonName(person.person_id),
          country: profile?.data.country_display || '',
          href: profile && isPublicPerson(profile) ? `/${lang}/artists/${profile.slug}` : '',
        };
      });
      const category = getProgramCategoryLabel(getLocalized(event.data.meta?.category, lang), event.data.program_line);
      const format = getLocalized(event.data.meta?.format, lang);
      const focusLabel = getLocalized(event.data.focus_label, lang);
      const focus = getLocalized(event.data.focus, lang);
      const locationRef = locationRefFromOccurrence || event.data.location_ref;
      const location = locationRef ? locations[locationRef] : undefined;
      const places = getOccurrenceLocationFacts(event);
      const firstPlace = places[0];

      return [
        getEventDetailKey(event.slug, date, dateLabel),
        {
          title: getLocalized(event.data.title, lang),
          category: category || event.data.program_line,
          format,
          dateLines: getEventDateLines(event),
          time: timeDisplay || event.data.schedule.time_display,
          place: firstPlace?.name || location?.name || locationRef || '',
          placeAddress: firstPlace?.address || location?.address || '',
          placeHref: firstPlace?.href || location?.href || '',
          places,
          people,
          description: getLocalized(event.data.body, lang) || getLocalized(event.data.summary, lang),
          focusLabel,
          focus,
          fullPageHref: isPublicDetailEvent(event) ? `/${lang}/program/${event.slug}` : '',
        },
      ];
    })
  ))
)));
---

<BaseLayout lang={lang} title={`${pageTitle} · Contact+ 2026`} description={intro}>
  <main class="schedule-page">
    <PageHero title={pageTitle} description={intro} context={labels.festivalContext} />

    <section class="schedule-controls" aria-label={pageTitle}>
      <nav class="day-nav" aria-label="Schedule days">
        {dayGroups.map(({ day }) => (
          <a class="day-nav__item" href={`#${getDayId(day)}`}>
            <span>{getLocalizedDateLabel(day, lang)}</span>
            <small>{getLocalizedDayName(day, lang)}</small>
          </a>
        ))}
      </nav>

      <div class="control-panel">
        <label class="schedule-search">
          <span>{labels.search}</span>
          <input type="search" placeholder={labels.searchPlaceholder} data-schedule-search />
        </label>

        <div class="control-stack">
          <div class="tool-group">
            <span class="tool-label">{labels.view}</span>
            <nav class="view-switch" aria-label="Program view">
              <a class="view-link active" href={`/${lang}/schedule`}>{labels.vertical}</a>
              <a class="view-link" href={`/${lang}/schedule/horizontal`}>{labels.horizontal}</a>
            </nav>
          </div>

          <div class="tool-group">
            <span class="tool-label">{labels.mode}</span>
            <div class="control-group" aria-label="View mode">
              <button class="control-pill active" type="button" data-mode-button="full_festival">{labels.full}</button>
              <button class="control-pill" type="button" data-mode-button="classes_performances">{labels.classes}</button>
            </div>
          </div>

          <div class="tool-group tool-group--wide">
            <span class="tool-label">{labels.filters}</span>
            <div class="control-group filters" aria-label="Filters">
              <button class="control-pill active" type="button" data-filter-button="all" aria-pressed="true">{labels.all}</button>
              <button class="control-pill" type="button" data-filter-button="ci" aria-pressed="false">{labels.ci}</button>
              <button class="control-pill" type="button" data-filter-button="performance_labs" aria-pressed="false">{labels.performanceLabs}</button>
              <button class="control-pill" type="button" data-filter-button="family_youth" aria-pressed="false">{labels.family}</button>
              <button class="control-pill" type="button" data-filter-button="performances" aria-pressed="false">{labels.performances}</button>
              <button class="control-pill" type="button" data-filter-button="jams_gatherings" aria-pressed="false">{labels.jams}</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="days" data-schedule-days aria-live="polite">
      {dayGroups.map(({ day, timeGroups }) => (
        <section class="day-block" id={getDayId(day)} data-day-block>
          <header class="day-head">
            <p>{getLocalizedDayName(day, lang)}</p>
            <h2>{getLocalizedDateLabel(day, lang)}</h2>
            <span>{getLocalizedDayTheme(day, lang)}</span>
          </header>
          <div class="day-events">
            {timeGroups.map(({ timeDisplay, occurrences }) => {
              const parallel = isParallelBlock(day, timeDisplay, occurrences);

              return (
              <section class="time-group" data-time-group>
                <div class="time-column">
                  <span>{timeDisplay}</span>
                  {parallel && <em class="parallel-label">{labels.parallel}</em>}
                </div>
                <div class={`time-events ${parallel ? 'has-parallel' : ''}`}>
                  {occurrences.map(({ event, date, dateLabel }) => {
                    const title = getLocalized(event.data.title, lang);
                    const category = getProgramCategoryLabel(getLocalized(event.data.meta?.category, lang), event.data.program_line);
                    const format = getLocalized(event.data.meta?.format, lang);
                    const summary = getLocalized(event.data.summary, lang);
                    const group = getProgramFilterGroup(event);
                    const detailKey = getEventDetailKey(event.slug, date, dateLabel);
                    const searchText = [
                      title,
                      category,
                      format,
                      summary,
                      event.data.people?.map((person) => person.person_id).join(' '),
                    ].filter(Boolean).join(' ');

                    return (
                      <article
                        class={`schedule-card program-accent program-accent--${group}`}
                        data-event-card
                        data-filter-group={group}
                        data-program-accent={group}
                        data-view-classes={isVisibleInProgramView(event, 'classes_performances') ? 'true' : 'false'}
                        data-search={searchText.toLowerCase()}
                        data-detail-key={detailKey}
                        role="button"
                        tabindex="0"
                        aria-label={`${labels.openDetails}: ${title}`}
                      >
                        <div class="event-body">
                          <p class="program-meta">
                            <span class="program-meta__category">{category || event.data.program_line}</span>
                            {format && <span class="program-meta__divider" aria-hidden="true"></span>}
                            {format && <span class="program-meta__format">{format}</span>}
                          </p>
                          <h3>{title}</h3>
                          <p>{summary}</p>
                        </div>
                      </article>
                    );
                  })}
                </div>
              </section>
              );
            })}
          </div>
        </section>
      ))}
      <p class="empty-message" data-empty-message hidden>{labels.empty}</p>
    </section>

    <div class="detail-overlay" data-detail-overlay hidden></div>
    <aside class="detail-panel" data-detail-panel aria-hidden="true" aria-modal="true" role="dialog" aria-labelledby="schedule-detail-title">
      <button class="detail-close" type="button" data-detail-close aria-label={labels.close}>×</button>
      <p class="program-meta detail-kicker">
        <span class="program-meta__category" data-detail-category></span>
        <span class="program-meta__divider" data-detail-format-divider aria-hidden="true"></span>
        <span class="program-meta__format" data-detail-format></span>
      </p>
      <h2 id="schedule-detail-title" data-detail-title></h2>
      <dl class="detail-facts">
        <div class="detail-fact">
          <dt>{labels.date}</dt>
          <dd data-detail-date></dd>
        </div>
        <div class="detail-fact">
          <dt>{labels.time}</dt>
          <dd data-detail-time></dd>
        </div>
        <div class="detail-fact detail-fact--wide" data-detail-place-wrap>
          <dt>{labels.place}</dt>
          <dd data-detail-place-list>
            <a class="detail-place-link" href="#" data-detail-place-link rel="noopener" target="_blank">
              <span data-detail-place></span>
              <small data-detail-place-address></small>
            </a>
          </dd>
        </div>
        <div class="detail-fact detail-fact--wide detail-people" data-detail-people-wrap>
          <dt data-detail-people-label>{labels.with}</dt>
          <dd data-detail-people></dd>
        </div>
      </dl>
      <div class="detail-description" data-detail-description></div>
      <section class="detail-focus" data-detail-focus-wrap hidden>
        <h3 data-detail-focus-label></h3>
        <p data-detail-focus></p>
      </section>
      <a class="detail-full-link" href="#" data-detail-full-page>{labels.fullPage}</a>
    </aside>
  </main>
</BaseLayout>

<script type="application/json" id="schedule-detail-data" set:html={JSON.stringify(eventDetails)}></script>

<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    const modeButtons = [...document.querySelectorAll('[data-mode-button]')];
    const filterButtons = [...document.querySelectorAll('[data-filter-button]')];
    const cards = [...document.querySelectorAll('[data-event-card]')];
    const timeGroups = [...document.querySelectorAll('[data-time-group]')];
    const dayBlocks = [...document.querySelectorAll('[data-day-block]')];
    const daysList = document.querySelector('[data-schedule-days]');
    const searchInput = document.querySelector('[data-schedule-search]');
    const emptyMessage = document.querySelector('[data-empty-message]');
    const detailData = JSON.parse(document.getElementById('schedule-detail-data')?.textContent || '{}');
    const detailOverlay = document.querySelector('[data-detail-overlay]');
    const detailPanel = document.querySelector('[data-detail-panel]');
    const detailClose = document.querySelector('[data-detail-close]');
    const detailFullPage = document.querySelector('[data-detail-full-page]');
    let lastFocusedCard = null;
    let activeMode = 'full_festival';
    const activeFilters = new Set();
    let activeSearch = '';

    function setActive(buttons, attr, value) {
      buttons.forEach((button) => {
        button.classList.toggle('active', button.getAttribute(attr) === value);
      });
    }

    function syncFilterButtons() {
      const hasSpecificFilters = activeFilters.size > 0;

      filterButtons.forEach((button) => {
        const filter = button.getAttribute('data-filter-button') || 'all';
        const active = filter === 'all' ? !hasSpecificFilters : activeFilters.has(filter);
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    }

    function renderSchedule() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const modeMatch = activeMode === 'full_festival' || card.getAttribute('data-view-classes') === 'true';
        const filterGroup = card.getAttribute('data-filter-group') || '';
        const filterMatch = activeFilters.size === 0 || activeFilters.has(filterGroup);
        const searchMatch = !activeSearch || (card.getAttribute('data-search') || '').includes(activeSearch);
        const visible = modeMatch && filterMatch && searchMatch;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      timeGroups.forEach((group) => {
        group.hidden = !group.querySelector('[data-event-card]:not([hidden])');
      });

      dayBlocks.forEach((block) => {
        const blockTimeGroups = [...block.querySelectorAll('[data-time-group]')];
        const visibleGroups = blockTimeGroups.filter((group) => !group.hidden);
        block.hidden = visibleGroups.length === 0;
        blockTimeGroups.forEach((group) => group.classList.remove('is-first-visible', 'is-last-visible'));
        visibleGroups[0]?.classList.add('is-first-visible');
        visibleGroups[visibleGroups.length - 1]?.classList.add('is-last-visible');
      });

      const hasActiveControls = activeMode !== 'full_festival' || activeFilters.size > 0 || Boolean(activeSearch);
      daysList?.classList.toggle('is-filtered', hasActiveControls);

      if (emptyMessage) emptyMessage.hidden = visibleCount > 0;
    }

    function setText(selector, value) {
      const element = document.querySelector(selector);
      if (element) element.textContent = value || '';
    }

    function openDetail(key, trigger) {
      const data = detailData[key];
      if (!data || !detailPanel || !detailOverlay) return;

      lastFocusedCard = trigger;
      detailPanel.setAttribute('data-accent', trigger?.getAttribute('data-program-accent') || '');
      setText('[data-detail-category]', data.category);
      setText('[data-detail-format]', data.format);
      const formatDivider = document.querySelector('[data-detail-format-divider]');
      const formatLabel = document.querySelector('[data-detail-format]');
      if (formatDivider) formatDivider.hidden = !data.format;
      if (formatLabel) formatLabel.hidden = !data.format;
      setText('[data-detail-title]', data.title);
      setText('[data-detail-time]', data.time);
      setText('[data-detail-place]', data.place);
      setText('[data-detail-place-address]', data.placeAddress);
      setText('[data-detail-description]', data.description);

      const dateList = document.querySelector('[data-detail-date]');
      if (dateList) {
        dateList.innerHTML = '';
        (data.dateLines || []).forEach((dateLine) => {
          const item = document.createElement('span');
          item.className = 'detail-date-line';
          const [dateValue, dayValue] = dateLine.split(' · ');

          const dateText = document.createElement('span');
          dateText.className = 'detail-date-value';
          dateText.textContent = dateValue;
          item.appendChild(dateText);

          if (dayValue) {
            const dayText = document.createElement('span');
            dayText.className = 'detail-date-days';
            dayText.textContent = ` · ${dayValue}`;
            item.appendChild(dayText);
          }

          dateList.appendChild(item);
        });
      }

      const placeWrap = document.querySelector('[data-detail-place-wrap]');
      const placeList = document.querySelector('[data-detail-place-list]');
      const places = data.places?.length ? data.places : (data.place ? [{
        name: data.place,
        address: data.placeAddress,
        href: data.placeHref,
        localizedDateLabel: '',
      }] : []);
      if (placeWrap) placeWrap.hidden = !places.length;
      if (placeList) {
        placeList.innerHTML = '';
        places.forEach((place) => {
          const placeElement = place.href ? document.createElement('a') : document.createElement('span');
          placeElement.className = 'detail-place-link';
          if (place.href) {
            placeElement.setAttribute('href', place.href);
            placeElement.setAttribute('rel', 'noopener');
            placeElement.setAttribute('target', '_blank');
          }

          if ((place.localizedDateLabel || place.dateLabel) && places.length > 1) {
            const date = document.createElement('small');
            date.className = 'detail-place-date';
            date.textContent = place.localizedDateLabel || place.dateLabel;
            placeElement.appendChild(date);
          }

          const name = document.createElement('span');
          name.textContent = place.name;
          placeElement.appendChild(name);

          if (place.address) {
            const address = document.createElement('small');
            address.textContent = place.address;
            placeElement.appendChild(address);
          }

          placeList.appendChild(placeElement);
        });
      }

      const peopleWrap = document.querySelector('[data-detail-people-wrap]');
      const peopleLabel = document.querySelector('[data-detail-people-label]');
      const peopleList = document.querySelector('[data-detail-people]');
      if (peopleWrap && peopleList) {
        peopleWrap.hidden = !data.people?.length;
        peopleList.innerHTML = '';
        if (data.people?.length) {
          if (peopleLabel) peopleLabel.textContent = data.people[0].label || peopleLabel.textContent;
          data.people.forEach((person) => {
            const row = document.createElement('span');
            row.className = 'detail-person-row';

            const nameWrap = person.href ? document.createElement('button') : document.createElement('span');
            nameWrap.className = 'detail-person-name-link';
            if (person.href) {
              nameWrap.setAttribute('type', 'button');
              nameWrap.setAttribute('data-person-href', person.href);
            }

            const name = document.createElement('span');
            name.className = 'detail-person-name';
            name.textContent = person.name;
            nameWrap.appendChild(name);
            row.appendChild(nameWrap);

            if (person.country) {
              const separator = document.createElement('span');
              separator.className = 'detail-person-separator';
              separator.setAttribute('aria-hidden', 'true');
              separator.textContent = ' · ';
              row.appendChild(separator);

              const country = document.createElement('span');
              country.className = 'detail-person-country';
              country.textContent = person.country;
              row.appendChild(country);
            }

            peopleList.appendChild(row);
          });
        }
      }

      const focusWrap = document.querySelector('[data-detail-focus-wrap]');
      if (focusWrap) {
        focusWrap.hidden = !data.focus;
        setText('[data-detail-focus-label]', data.focusLabel);
        setText('[data-detail-focus]', data.focus);
      }

      if (detailFullPage) {
        detailFullPage.hidden = !data.fullPageHref;
        detailFullPage.setAttribute('href', data.fullPageHref || '#');
      }

      detailOverlay.hidden = false;
      detailPanel.classList.add('open');
      detailOverlay.classList.add('open');
      detailPanel.setAttribute('aria-hidden', 'false');
      detailClose?.focus();
    }

    function closeDetail() {
      if (!detailPanel || !detailOverlay) return;
      detailPanel.classList.remove('open');
      detailOverlay.classList.remove('open');
      detailPanel.setAttribute('aria-hidden', 'true');
      detailOverlay.hidden = true;
      lastFocusedCard?.focus?.();
    }

    modeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeMode = button.getAttribute('data-mode-button') || 'full_festival';
        setActive(modeButtons, 'data-mode-button', activeMode);
        renderSchedule();
      });
    });

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter-button') || 'all';

        if (filter === 'all') {
          activeFilters.clear();
        } else if (activeFilters.has(filter)) {
          activeFilters.delete(filter);
        } else {
          activeFilters.add(filter);
        }

        syncFilterButtons();
        renderSchedule();
      });
    });

    searchInput?.addEventListener('input', () => {
      activeSearch = searchInput.value.trim().toLowerCase();
      renderSchedule();
    });

    cards.forEach((card) => {
      card.addEventListener('click', () => openDetail(card.getAttribute('data-detail-key'), card));
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openDetail(card.getAttribute('data-detail-key'), card);
        }
      });
    });

    document.addEventListener('click', (event) => {
      const personLink = event.target.closest('[data-person-href]');
      if (!personLink) return;
      window.location.href = personLink.getAttribute('data-person-href');
    });

    detailClose?.addEventListener('click', closeDetail);
    detailOverlay?.addEventListener('click', closeDetail);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeDetail();
    });

    syncFilterButtons();
    renderSchedule();
  });
</script>

