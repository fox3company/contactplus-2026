---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { isLocale } from '../../lib/locales';
import { partnerLogos, partnersCopy } from '../../lib/partners';

export function getStaticPaths() {
  return ['en', 'ro', 'ru'].map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
if (!isLocale(lang)) return Astro.redirect('/en/partners');
const copy = partnersCopy[lang];
---

<BaseLayout lang={lang} title={`${copy.title} · Contact+ 2026`} description={copy.lead}>
  <main class="partners-page">
    <PageHero title={copy.title} description={copy.lead} />

    <section class="partners-section" aria-labelledby="support-title">
      <div class="partners-section__heading">
        <h2 id="support-title">{copy.supportTitle}</h2>
      </div>
      <div class="partners-list partners-list--support">
        {partnerLogos.support.map((partner) => (
          <a class:list={['partner-card', partner.className]} href={partner.href} rel="noreferrer noopener" target="_blank">
            <div class="partner-card__mark" aria-hidden="true">
              <img src={partner.src} alt="" loading="lazy" />
            </div>
            <div class="partner-card__content">
              <h3>{partner.name[lang]}</h3>
              <p>{partner.role[lang]}</p>
              <span>{copy.visitSite} <span aria-hidden="true">↗</span></span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="partners-section" aria-labelledby="partners-title">
      <div class="partners-section__heading">
        <h2 id="partners-title">{copy.partnersTitle}</h2>
      </div>
      <div class="partners-list partners-list--partners">
        {partnerLogos.partners.map((partner) => (
          <a class:list={['partner-card', partner.className]} href={partner.href} rel="noreferrer noopener" target="_blank">
            <div class="partner-card__mark" aria-hidden="true">
              <img src={partner.src} alt="" loading="lazy" />
            </div>
            <div class="partner-card__content">
              <h3>{partner.name[lang]}</h3>
              <p>{partner.role[lang]}</p>
              <span>{copy.visitSite} <span aria-hidden="true">↗</span></span>
            </div>
          </a>
        ))}
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .partners-page { width: min(100% - 48px, 1040px); margin: 0 auto; padding: 0 0 clamp(72px, 9vw, 120px); color: var(--ink); }
  .partners-section { padding: clamp(42px, 5vw, 64px) 0 clamp(58px, 7vw, 88px); border-top: 1px solid var(--line); }
  .partners-section__heading { margin-bottom: clamp(32px, 4vw, 46px); }
  .partners-section__heading h2 { margin: 0; font: 400 clamp(2rem, 3vw, 2.8rem)/1.04 var(--font-serif); }
  .partners-list { display: grid; }
  .partners-list--support { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(40px, 7vw, 104px); }
  .partners-list--partners { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(46px, 5vw, 70px) clamp(40px, 7vw, 104px); }
  .partner-card { display: block; min-width: 0; color: inherit; text-decoration: none; transition: color .18s ease; }
  .partner-card__mark { display: flex; align-items: center; justify-content: flex-start; height: 112px; margin-bottom: 20px; overflow: hidden; }
  .partner-card__mark img { display: block; max-width: 100%; width: auto; height: 70px; object-fit: contain; object-position: left center; }
  .partner-card--ministry .partner-card__mark img { height: 74px; }
  .partner-card--bank .partner-card__mark img { height: 54px; }
  .partner-card--nod .partner-card__mark img { width: 164px; height: 88px; }
  .partner-card--artcor .partner-card__mark img { width: 210px; height: 76px; }
  .partner-card--om .partner-card__mark img { width: 142px; height: 74px; filter: invert(1); }
  .partner-card--letto .partner-card__mark img { width: 138px; height: 76px; mix-blend-mode: multiply; }
  .partner-card__content { display: grid; gap: 7px; max-width: 31ch; }
  .partner-card__content h3 { margin: 0; font: 400 clamp(1.22rem, 1.65vw, 1.48rem)/1.1 var(--font-serif); }
  .partner-card__content p { margin: 0; color: var(--muted); font: 400 .92rem/1.45 var(--font-sans); }
  .partner-card__content > span { margin-top: 8px; color: var(--accent); font: 650 .8rem/1.2 var(--font-sans); letter-spacing: .03em; }
  .partner-card:hover h3, .partner-card:focus-visible h3 { color: var(--accent); }
  .partner-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  @media (max-width: 760px) {
    .partners-page { width: min(100% - 30px, 620px); padding-bottom: 90px; }
    .partners-section { padding: 38px 0 56px; }
    .partners-section__heading { margin-bottom: 30px; }
    .partners-list--support, .partners-list--partners { grid-template-columns: 1fr; }
    .partners-list--support, .partners-list--partners { gap: 42px; }
    .partner-card__mark { height: 94px; margin-bottom: 16px; }
    .partner-card__mark img { height: 60px; }
    .partner-card--nod .partner-card__mark img { width: 132px; height: 70px; }
    .partner-card--bank .partner-card__mark img { height: 50px; }
    .partner-card--artcor .partner-card__mark img { width: 174px; height: 64px; }
    .partner-card--om .partner-card__mark img { width: 118px; height: 62px; }
    .partner-card--letto .partner-card__mark img { width: 118px; height: 66px; }
  }
</style>
