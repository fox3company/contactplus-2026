---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalized, isLocale } from '../../lib/locales';
import { locations } from '../../lib/locations';
import { getProgramOccurrences, isPublicDetailEvent, isPublicScheduleEvent } from '../../lib/program';
import { getLocalizedDateLabel } from '../../lib/festivalDates';
import { festivalMapUrl, venueDetails, venuesCopy } from '../../lib/venues';

export async function getStaticPaths() {
  return ['en', 'ro', 'ru'].map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
if (!isLocale(lang)) return Astro.redirect('/en/venues');

const copy = venuesCopy[lang];
const events = await getCollection('events', isPublicScheduleEvent);
const occurrences = getProgramOccurrences(events);
const venues = Object.entries(locations).flatMap(([locationRef, venue]) => {
  const details = venueDetails[locationRef];
  if (!details) return [];

  const allProgram = occurrences
    .filter((occurrence) => occurrence.locationRef === locationRef)
    .map((occurrence) => ({
      slug: occurrence.event.slug,
      title: getLocalized(occurrence.event.data.title, lang),
      date: getLocalizedDateLabel(occurrence.dateLabel, lang),
      time: occurrence.timeDisplay,
      href: isPublicDetailEvent(occurrence.event)
        ? `/${lang}/program/${occurrence.event.slug}`
        : `/${lang}/schedule?venue=${locationRef}`,
      sortValue: occurrence.sortStart ? Date.parse(occurrence.sortStart) : Number.MAX_SAFE_INTEGER,
    }));

  const uniqueProgram = allProgram.filter((item, index) => allProgram.findIndex((candidate) => candidate.slug === item.slug) === index);
  const firstActivity = uniqueProgram[0];
  return [{
    locationRef,
    venue,
    details,
    firstActivity,
    program: uniqueProgram.slice(0, 6),
    remainingProgramCount: uniqueProgram.length - 6,
    mobileRemainingProgramCount: Math.max(uniqueProgram.length - 2, 0),
  }];
}).sort((a, b) => (a.firstActivity?.sortValue || Infinity) - (b.firstActivity?.sortValue || Infinity));

const hiddenVenueRefs = new Set([
  'art-studio-21',
]);

const mapVenues = venues
  .filter(({ locationRef }) => !hiddenVenueRefs.has(locationRef))
  .map(({ locationRef, venue, details }) => ({
    id: locationRef,
    name: venue.name,
    address: venue.address || '',
    href: venue.href,
    anchor: `#${locationRef}`,
    detailAction: copy.mapDetailAction,
    coordinates: details.coordinates,
  }));

const venueGroups = [
  {
    key: 'core',
    ...copy.groups.core,
    refs: ['nod-space', 'festival-studio'],
  },
  {
    key: 'performances',
    ...copy.groups.performances,
    refs: ['ginta-latina', 'artcor-creative-hub'],
  },
  {
    key: 'one-off',
    ...copy.groups.oneOff,
    refs: ['great-national-assembly-square'],
  },
].map((group) => ({
  ...group,
  venues: group.refs.flatMap((locationRef) => venues.filter((venue) => venue.locationRef === locationRef)),
}));
---

<BaseLayout lang={lang} title={`${copy.title} · Contact+ 2026`} description={copy.lead} noindex={true}>
  <main class="venues-page">
    <header class="venues-hero">
      <div class="venues-hero__copy">
        <h1>{copy.title}</h1>
        <p class="venues-hero__lead">{copy.lead}</p>
      </div>
    </header>

    <section class="venues-map" aria-labelledby="venues-map-title">
      <div class="venues-map__copy">
        <h2 id="venues-map-title">{copy.mapTitle}</h2>
        <p>{copy.mapText}</p>
        <a class="venues-action" href={festivalMapUrl} rel="noopener" target="_blank">{copy.mapAction} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="venues-map__canvas-wrap">
        <div class="venues-map__canvas" id="festival-venues-map" aria-label={copy.mapTitle}></div>
        <a class="venues-map__fallback" href={festivalMapUrl} rel="noopener" target="_blank">{copy.mapFallback} <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <nav class="venues-jump-nav" aria-label={copy.browseVenues}>
      {venueGroups.map((group) => <a href={`#venue-group-${group.key}`}>{group.title}</a>)}
    </nav>

    <section class="venues-list" aria-labelledby="venues-list-title">
      <header class="venues-list__header">
        <h2 id="venues-list-title">{copy.listTitle}</h2>
        <div>
          <p>{copy.listText}</p>
        </div>
      </header>

      <div class="venues-groups">
        {venueGroups.map((group, groupIndex) => (
          <section class="venue-group" id={`venue-group-${group.key}`} aria-labelledby={`venue-group-title-${group.key}`}>
            <header class="venue-group__header">
              <span class="venue-group__index" aria-hidden="true">{String(groupIndex + 1).padStart(2, '0')}</span>
              <div>
                <h3 id={`venue-group-title-${group.key}`}>{group.title}</h3>
                <p>{group.text}</p>
              </div>
            </header>

            <div class="venues-list__items">
              {group.venues.map(({ locationRef, venue, details, program, remainingProgramCount, mobileRemainingProgramCount }) => (
                <article class="venue-entry" id={locationRef}>
                  <div class="venue-entry__main">
                    <h3>{venue.name}</h3>
                    <p class="venue-entry__description">{details.description[lang]}</p>
                    <div class="venue-entry__location">
                      {venue.address && <a class="venue-entry__address" href={venue.href} rel="noopener" target="_blank"><span>{copy.addressLabel}</span><span class="venue-entry__address-value">{venue.address} <span aria-hidden="true">↗</span></span></a>}
                    </div>
                  </div>
                  <div class="venue-entry__program">
                    <div class="venue-entry__program-head">
                      <h4>{copy.programLabel}</h4>
                    </div>
                    {program.length > 0 ? (
                      <ul>
                        {program.map((item) => (
                          <li>
                            <span>{item.date} · {item.time}</span>
                            <a href={item.href}>{item.title}</a>
                          </li>
                        ))}
                      </ul>
                    ) : <p>—</p>}
                    <div class="venue-entry__program-actions">
                      {remainingProgramCount > 0 && <p class="venue-entry__more-program venue-entry__more-program--desktop">{copy.moreProgram(remainingProgramCount)}</p>}
                      {mobileRemainingProgramCount > 0 && <p class="venue-entry__more-program venue-entry__more-program--mobile">{copy.moreProgram(mobileRemainingProgramCount)}</p>}
                      <a class="venue-entry__schedule-link" href={`/${lang}/schedule?venue=${locationRef}`}>{copy.scheduleAction} <span aria-hidden="true">→</span></a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<script type="application/json" id="venue-map-data" set:html={JSON.stringify(mapVenues)}></script>
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    const mapElement = document.getElementById('festival-venues-map');
    const dataElement = document.getElementById('venue-map-data');
    if (!mapElement || !dataElement || !window.L) return;

    const venues = JSON.parse(dataElement.textContent || '[]');
    const map = window.L.map(mapElement, { scrollWheelZoom: false, zoomControl: true });
    window.L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors',
      maxZoom: 19,
    }).addTo(map);

    const bounds = [];
    venues.forEach((venue) => {
      const marker = window.L.marker(venue.coordinates).addTo(map);
      const popup = `<strong>${venue.name}</strong><span>${venue.address}</span><a href="${venue.anchor}">${venue.detailAction}</a>`;
      marker.bindPopup(popup);
      bounds.push(venue.coordinates);
    });

    if (bounds.length) map.fitBounds(bounds, { padding: [34, 34], maxZoom: 14 });
    mapElement.parentElement?.classList.add('is-map-ready');
  });
</script>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
  .venues-page {
    width: min(1240px, calc(100% - 40px));
    margin: 0 auto;
    padding: clamp(42px, 6vw, 84px) 0 clamp(88px, 10vw, 132px);
  }

  .venues-hero__copy { max-width: 790px; }
  .venues-hero h1, .venues-map h2, .venues-list h2 {
    margin: 0 0 18px;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 6vw, 5.3rem);
    font-weight: 400;
    line-height: .98;
  }
  .venues-hero__lead {
    max-width: 680px;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.08rem, 1.55vw, 1.32rem);
    line-height: 1.52;
  }
  .venues-map {
    display: grid;
    grid-template-columns: minmax(250px, .65fr) minmax(480px, 1.35fr);
    gap: clamp(34px, 6vw, 90px);
    align-items: center;
    margin-top: clamp(44px, 6vw, 78px);
  }
  .venues-map h2 {
    max-width: 580px;
    margin-bottom: 14px;
    font-size: clamp(2rem, 3.7vw, 3.4rem);
  }
  .venues-map p, .venues-list__header p {
    max-width: 620px;
    margin: 0;
    color: var(--muted);
    line-height: 1.5;
  }
  .venues-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 22px;
    background: var(--accent);
    color: white;
    font-weight: 680;
    text-decoration: none;
    white-space: nowrap;
  }
  .venues-map .venues-action { margin-top: 26px; }
  .venues-action:hover, .venues-action:focus-visible { background: var(--accent-muted); }
  .venues-map__canvas-wrap { position: relative; min-height: 430px; }
  .venues-map__canvas { position: absolute; inset: 0; background: var(--paper-deep); }
  .venues-map__fallback {
    position: absolute;
    z-index: 2;
    right: 16px;
    bottom: 16px;
    padding: 10px 12px;
    background: var(--paper);
    color: var(--accent-muted);
    font-size: .76rem;
    font-weight: 680;
    text-decoration: none;
  }
  .venues-map__canvas-wrap.is-map-ready .venues-map__fallback { display: none; }
  :global(.leaflet-control-zoom a) { color: var(--ink) !important; }
  :global(.leaflet-popup-content-wrapper), :global(.leaflet-popup-tip) { border-radius: 0; }
  :global(.leaflet-popup-content) { display: grid; gap: 8px; min-width: 180px; margin: 14px 16px; color: var(--ink); font-family: var(--font-sans); }
  :global(.leaflet-popup-content strong) { font-family: var(--font-serif); font-size: 1.05rem; font-weight: 400; }
  :global(.leaflet-popup-content span) { color: var(--muted); font-size: .77rem; line-height: 1.35; }
  :global(.leaflet-popup-content a) { color: var(--accent-muted); font-size: .76rem; font-weight: 680; text-decoration: none; }

  .venues-list { margin-top: clamp(68px, 10vw, 132px); }
  .venues-jump-nav { display: none; }
  .venues-list__header {
    display: grid;
    grid-template-columns: minmax(260px, .9fr) minmax(300px, 1.1fr);
    gap: clamp(34px, 8vw, 122px);
    align-items: end;
    margin-bottom: clamp(34px, 5vw, 62px);
  }
  .venues-list h2 { margin: 0; font-size: clamp(2.1rem, 4.3vw, 4rem); }
  .venues-groups { display: grid; gap: clamp(66px, 9vw, 118px); }
  .venue-group__header {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    margin-bottom: 26px;
  }
  .venue-group__index {
    padding-top: 5px;
    color: var(--accent-muted);
    font-size: .72rem;
    font-weight: 680;
    letter-spacing: .1em;
  }
  .venue-group__header h3 {
    margin: 0 0 8px;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    font-weight: 400;
    line-height: 1.04;
  }
  .venue-group__header p {
    max-width: 610px;
    margin: 0;
    color: var(--muted);
    font-size: .94rem;
    line-height: 1.5;
  }
  .venue-group .venues-list__items { border-top: 1px solid var(--line); }

  .venue-entry {
    display: grid;
    grid-template-columns: minmax(240px, .86fr) minmax(320px, 1.14fr);
    gap: clamp(20px, 4vw, 70px);
    padding: clamp(24px, 3.2vw, 42px) 0;
    border-bottom: 1px solid var(--line);
  }
  .venue-entry h3 {
    margin: -4px 0 14px;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(1.55rem, 2.4vw, 2.05rem);
    font-weight: 400;
    line-height: 1.08;
  }
  .venue-entry__description {
    max-width: 390px;
    margin: 0 0 20px;
    color: var(--muted);
    font-size: .94rem;
    line-height: 1.48;
  }
  .venue-entry__address {
    display: grid;
    gap: 4px;
    max-width: 330px;
    margin: 0;
    color: var(--muted);
    font-size: .9rem;
    line-height: 1.42;
    text-decoration: none;
  }
  .venue-entry__address > span:first-child, .venue-entry__program h4, .venue-entry__program-head p span {
    color: var(--accent-muted);
    font-size: .7rem;
    font-weight: 680;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .venue-entry__schedule-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 18px;
    color: var(--accent-muted);
    font-size: .82rem;
    font-weight: 680;
    text-decoration: none;
  }
  .venue-entry__address:hover .venue-entry__address-value, .venue-entry__address:focus-visible .venue-entry__address-value,
  .venue-entry__schedule-link:hover, .venue-entry__schedule-link:focus-visible,
  .venue-entry__program a:hover, .venue-entry__program a:focus-visible { text-decoration: underline; text-underline-offset: 3px; }
  .venue-entry__program h4 { margin: 0 0 12px; }
  .venue-entry__program-head { margin-bottom: 12px; }
  .venue-entry__program-head h4 { margin: 0; }
  .venue-entry__program ul { margin: 0; padding: 0; list-style: none; }
  .venue-entry__program li {
    display: grid;
    grid-template-columns: minmax(132px, .55fr) minmax(0, 1fr);
    gap: 16px;
    padding: 9px 0;
    border-top: 1px solid color-mix(in srgb, var(--line) 58%, transparent);
  }
  .venue-entry__program li:first-child { border-top: 0; padding-top: 0; }
  .venue-entry__program li span { color: var(--muted); font-size: .76rem; line-height: 1.4; }
  .venue-entry__program li a, .venue-entry__program li strong { color: color-mix(in srgb, var(--ink) 82%, var(--muted)); font-size: .88rem; font-weight: 400; line-height: 1.38; text-decoration: none; }
  .venue-entry__program li a { display: flex; align-items: center; min-height: 44px; }
  .venue-entry__program > p { margin: 0; color: var(--muted); }
  .venue-entry__more-program { margin-top: 10px !important; font-size: .78rem; }
  .venue-entry__more-program--mobile { display: none; }
  .venue-entry__schedule-link { margin-top: 16px; }
  .venue-entry__program-actions {
    display: grid;
    grid-template-columns: minmax(132px, .55fr) minmax(0, 1fr);
    column-gap: 16px;
  }
  .venue-entry__program-actions > * { grid-column: 2; }

  @media (max-width: 760px) {
    .venues-page { width: min(100% - 30px, 620px); padding-top: 36px; }
    .venues-hero h1 { font-size: clamp(2.8rem, 14vw, 4.15rem); }
    .venues-map, .venues-list__header { display: block; }
    .venues-map { margin-top: 54px; }
    .venues-action { width: 100%; margin-top: 26px; }
    .venues-map__canvas-wrap { min-height: min(108vw, 400px); margin-top: 28px; }
    .venues-jump-nav { display: flex; gap: 22px; margin-top: 28px; padding: 0 0 14px; overflow-x: auto; border-bottom: 1px solid var(--line); scrollbar-width: thin; }
    .venues-jump-nav a { flex: 0 0 auto; display: inline-flex; align-items: center; min-height: 44px; color: var(--accent-muted); font-size: .9rem; font-weight: 680; text-decoration: none; white-space: nowrap; }
    .venues-jump-nav a:hover, .venues-jump-nav a:focus-visible { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
    .venues-list { margin-top: 54px; }
    .venues-list__header p { margin-top: 18px; }
    .venues-groups { gap: 58px; }
    .venue-group__header { grid-template-columns: 28px minmax(0, 1fr); gap: 12px; margin-bottom: 18px; }
    .venue-group__index { padding-top: 3px; font-size: .66rem; }
    .venue-group__header h3 { font-size: clamp(1.65rem, 8vw, 2.15rem); }
    .venue-group__header p { font-size: .88rem; }
    .venue-group .venues-list__items { display: grid; gap: 16px; border-top: 0; }
    .venue-entry { grid-template-columns: minmax(0, 1fr); gap: 0; padding: 22px 20px 18px; background: var(--paper-deep); border: 1px solid var(--line); border-radius: 8px; }
    .venue-entry h3 { margin: 0 0 10px; font-size: clamp(1.7rem, 8.2vw, 2rem); }
    .venue-entry__description { margin-bottom: 16px; }
    .venue-entry__location { display: grid; }
    .venue-entry__address { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: baseline; column-gap: 8px; max-width: none; font-size: .84rem; }
    .venue-entry__address > span:first-child { white-space: nowrap; }
    .venue-entry__address-value { min-width: 0; }
    .venue-entry__address > span:first-child,
    .venue-entry__program h4 { color: var(--muted); }
    .venue-entry__program { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--line); }
    .venue-entry__program-head { margin-bottom: 8px; }
    .venue-entry__program li { grid-template-columns: 1fr; gap: 2px; }
    .venue-entry__program li:nth-child(n + 3) { display: none; }
    .venue-entry__program li { padding: 9px 0; }
    .venue-entry__program li span { font-size: .74rem; }
    .venue-entry__program li a { min-height: 32px; font-size: .92rem; }
    .venue-entry__more-program--desktop { display: none; }
    .venue-entry__more-program--mobile { display: block; }
    .venue-entry__program-actions { display: grid; grid-template-columns: 1fr; gap: 4px; padding-top: 6px; }
    .venue-entry__program-actions > * { grid-column: auto; }
    .venue-entry__more-program { margin: 0 !important; color: var(--muted) !important; font-size: .76rem; }
    .venue-entry__schedule-link { min-height: 40px; margin-top: 0; font-size: .88rem; }
  }
</style>
