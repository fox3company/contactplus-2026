---
interface Props {
  items: string[];
  ariaLabel?: string;
}

const { items, ariaLabel } = Astro.props;
---

<ul class="inclusion-list" aria-label={ariaLabel}>
  {items.map((item) => <li>{item}</li>)}
</ul>

<style>
  .inclusion-list {
    display: grid;
    gap: 9px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .inclusion-list li {
    position: relative;
    padding-left: 19px;
    color: var(--muted);
  }

  .inclusion-list li::before {
    position: absolute;
    top: .72em;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent-muted);
    content: "";
  }
</style>
