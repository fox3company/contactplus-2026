---
import { aboutCopy, aboutMedia } from '../lib/about';
import type { Locale } from '../lib/locales';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const copy = aboutCopy[lang];
const registrationUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSdkDT1NjKXxzbAg_8dqSLEDnYPstOaBZ8oE6mxqNHkLTUbBlg/viewform?usp=header';
const vimeoPlayerUrl = 'https://player.vimeo.com/video/1211155266?title=0&byline=0&portrait=0';
const organiserGroups = [
  {
    label: copy.organisers.coreGroup,
    items: [
      { names: ['Alexandra Soshnicova', 'Sergey Golovnea'], links: ['https://www.facebook.com/alexandra.soshnicova', 'https://www.facebook.com/golovnea'], role: copy.organisers.dance },
      { names: ['Anriana Celan'], links: ['https://www.facebook.com/adriana.celan'], role: copy.organisers.manager },
    ],
  },
  {
    label: copy.organisers.partnersGroup,
    items: [
      { names: [copy.organisers.festivalTeam], links: ['https://www.facebook.com/fest.contactplus'], role: '' },
      { names: [copy.organisers.community], links: ['https://www.facebook.com/contempdance/'], role: '' },
    ],
  },
  {
    label: copy.organisers.supportGroup,
    items: [
      { names: ['Stan Potoku'], links: ['https://www.facebook.com/stanpotoku'], role: copy.organisers.musician },
      { names: ['Olyga Braga', 'Tara Diamondbreath'], links: ['https://www.facebook.com/oliga.braga', 'https://www.facebook.com/bodhi.tara'], role: copy.organisers.support },
    ],
  },
];
---

<main class="about-page">
  <header class="about-hero">
    <div class="about-hero__copy">
      <p class="eyebrow">{copy.strapline}</p>
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
      <p class="about-hero__facts">{copy.date}<span aria-hidden="true">·</span>{copy.place}</p>
    </div>
    <div class="about-hero__media about-media--hero">
      <video data-autoplay-video autoplay muted loop playsinline preload="metadata" poster={aboutMedia.heroPoster} aria-label={copy.video.heroLabel}>
        <source src={aboutMedia.heroVideo} type="video/mp4" />
      </video>
    </div>
  </header>

  <section class="about-section about-section--what" aria-labelledby="about-what">
    <div class="about-section__text"><h2 id="about-what">{copy.what.title}</h2><p class="about-section__lead">{copy.what.text}</p></div>
    <div class="about-media--landscape"><img src={aboutMedia.what} alt="People sharing movement and attention in a Contact Improvisation practice" width="2048" height="1365" loading="lazy" decoding="async" /></div>
  </section>

  <section class="about-section about-section--why" aria-labelledby="about-why">
    <div class="about-why__layout">
      <div class="about-why__media about-media--landscape"><img src={aboutMedia.why[4]} alt="Performers sharing movement and attention on stage" width="2048" height="1367" loading="lazy" decoding="async" /></div>
      <div class="about-why__copy"><h2 id="about-why">{copy.why.title}</h2><ul>{copy.why.items.map((item: string) => <li>{item}</li>)}</ul></div>
    </div>
  </section>

  <section class="about-section about-section--unfold" aria-labelledby="about-unfold">
    <header><h2 id="about-unfold">{copy.unfold.title}</h2><p>{copy.unfold.text}</p></header>
    <div class="about-unfold__body">
      <div class="about-unfold__chapter about-unfold__structure">
        <div class="about-unfold__intro">
          <h3>{copy.unfold.structureTitle}</h3>
          <p>{copy.unfold.structureText}</p>
        </div>
        <ol class="about-entry-points" aria-label={copy.unfold.structureTitle}>
          {copy.unfold.dimensions.map((item: string, index: number) => <li><span class="about-entry-points__number">0{index + 1}</span><span class="about-entry-points__name">{item}</span><span class="about-entry-points__text">{copy.unfold.dimensionText[index]}</span></li>)}
        </ol>
      </div>
      <div class="about-unfold__chapter about-unfold__rhythm">
        <div class="about-unfold__intro">
          <h3>{copy.day.title}</h3>
          <p>{copy.day.note}</p>
        </div>
        <div class="about-day-arc">
          {[0, 1, 2].map((phase) => <article><span class="about-day-arc__number">0{phase + 1}</span><span class="about-day-arc__time">{copy.day.phaseTimes[phase]}</span><h4>{copy.day.phaseTitles[phase]}</h4><p>{copy.day.phaseTexts[phase]}</p><ul><li>{copy.day.items[phase * 2]}</li><li>{copy.day.items[phase * 2 + 1]}</li></ul></article>)}
        </div>
      </div>
      <div class="about-unfold__chapter about-festival-film">
        <div class="about-unfold__intro">
          <h3>{copy.video.filmLabel}</h3>
          <p>{copy.video.filmText}</p>
        </div>
        <div class="about-festival-film__media" data-vimeo-shell>
          <iframe src={vimeoPlayerUrl} title={copy.video.vimeoLabel} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="about-section about-section--who" aria-labelledby="about-who">
    <div class="about-who__copy"><h2 id="about-who">{copy.who.title}</h2><p>{copy.who.intro}</p><ul>{copy.who.groups.map((item: string) => <li>{item}</li>)}</ul><div class="about-who__entry"><h3>{copy.who.entry}</h3><p>{copy.who.entryText}</p></div></div>
    <div class="about-who__media"><img src={aboutMedia.who[0]} alt="A large group sharing movement in an open space" width="2048" height="1367" loading="lazy" decoding="async" /></div>
  </section>

  <section class="about-section about-section--city" aria-labelledby="about-city"><img src={aboutMedia.city} alt="People moving together outdoors in Chișinău" width="2048" height="1367" loading="lazy" decoding="async" /><div><h2 id="about-city">{copy.city.title}</h2><p class="about-section__lead">{copy.city.text}</p></div></section>

  <section class="about-section about-section--organisers" aria-labelledby="about-organisers">
    <div class="about-organisers__layout">
      <div class="about-organisers__copy">
        <h2 id="about-organisers">{copy.organisers.title}</h2>
        <p class="about-section__lead">{copy.organisers.intro}</p>
        <div class="about-organisers__groups">
          {organiserGroups.map((group) => <section class="about-organisers__group"><h3 class="about-organisers__group-title">{group.label}</h3><div class="about-organisers__items">{group.items.map((organiser) => <p class="about-organisers__item"><span class="about-organisers__names">{organiser.names.map((name, index) => <><a class="about-organisers__link" href={organiser.links[index]} rel="noopener" target="_blank">{name}</a>{index < organiser.names.length - 1 && ', '}</>)}</span>{organiser.role && <small class="about-organisers__role">{organiser.role}</small>}</p>)}</div></section>)}
        </div>
      </div>
      <div class="about-organisers__media about-media--landscape"><img src={aboutMedia.organisers} alt="People greeting each other during the festival" width="2048" height="1365" loading="lazy" decoding="async" /></div>
    </div>
  </section>

  <section class="about-practical" id="passes-participation"><section class="about-section about-section--participation" aria-labelledby="about-participation"><p class="eyebrow">{copy.participation.title}</p><h2 id="about-participation">{copy.participation.title}</h2><p>{copy.participation.text}</p><div class="about-actions"><a class="about-action about-action--primary" href={registrationUrl} rel="noopener" target="_blank">{copy.participation.register}</a></div></section><section class="about-section about-section--faq" aria-labelledby="about-faq"><h2 id="about-faq">{copy.faqTitle}</h2><div class="about-faq">{copy.faq.map(([question, answer]: [string, string]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section></section>

  <section class="about-explore" aria-labelledby="about-explore"><img src={aboutMedia.closing} alt="A group of performers sharing a vivid stage moment" width="3600" height="2384" loading="lazy" decoding="async" /><div><h2 id="about-explore">{copy.explore.title}</h2><nav aria-label={copy.explore.title}><a href={`/${lang}/program`}>{copy.explore.program}</a><a href={`/${lang}/schedule`}>{copy.explore.schedule}</a><a href={`/${lang}/artists`}>{copy.explore.artists}</a></nav></div></section>
</main>

<script is:inline>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll('[data-autoplay-video]').forEach((video) => {
    if (reduceMotion.matches) {
      video.removeAttribute('autoplay');
      video.pause();
    }
  });
</script>

<style>
  .about-page { width: min(1240px, calc(100% - 40px)); margin: 0 auto; padding: clamp(40px, 5vw, 68px) 0 clamp(44px, 6vw, 78px); }
  .about-hero { margin-bottom: clamp(48px, 6vw, 82px); }
  .about-hero__copy { max-width: 810px; margin-bottom: clamp(22px, 3.2vw, 42px); }
  .about-hero h1 { max-width: 760px; margin: 12px 0 18px; }
  .about-hero__facts { display: flex; flex-wrap: wrap; gap: 7px; margin: 24px 0 0; color: var(--accent-muted); font-size: .78rem; font-weight: 650; letter-spacing: .07em; text-transform: uppercase; }
  .about-hero__media, .about-day__media, .about-media--hero, .about-media--landscape, .about-media--portrait, .about-media--sequence, .about-media--video { position: relative; overflow: hidden; background: #222; }
  .about-day__media { background: transparent; }
  .about-media--hero { aspect-ratio: 16 / 9; }
  .about-media--landscape { aspect-ratio: 3 / 2; }
  .about-media--portrait { aspect-ratio: 4 / 5; max-height: min(680px, 72vh); }
  .about-media--sequence { aspect-ratio: 4 / 5; }
  .about-hero video, .about-day video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .about-section { margin: clamp(80px, 8vw, 112px) 0; }
  .about-section h2, .about-explore h2 { max-width: 680px; margin: 8px 0 20px; font-family: var(--font-serif); font-size: clamp(2rem, 3.8vw, 3.35rem); font-weight: 400; line-height: 1.08; }
  .about-section h3 { margin: 26px 0 12px; font-size: .82rem; letter-spacing: .07em; text-transform: uppercase; }
  .about-section p { max-width: 660px; color: var(--muted); }
  .about-section__lead { font-size: clamp(1.08rem, 1.55vw, 1.32rem); line-height: 1.52; }
  .about-section img, .about-explore img { display: block; width: 100%; height: auto; object-fit: cover; }
  .about-section--what { display: grid; grid-template-columns: minmax(280px, .9fr) minmax(360px, 1.1fr); gap: clamp(34px, 8vw, 122px); align-items: start; padding-top: clamp(18px, 4vw, 54px); }
  .about-section--what h2 { margin-bottom: 26px; }
  .about-section--what > .about-media--landscape { max-height: min(680px, 72vh); }
  .about-section--what > .about-media--landscape img { object-position: center; }
  .about-section--why { margin-top: clamp(80px, 9vw, 112px); }
  .about-why__layout { display: grid; grid-template-columns: minmax(0, 7fr) minmax(280px, 5fr); gap: clamp(34px, 7vw, 96px); align-items: center; }
  .about-why__media { aspect-ratio: 3 / 2; }
  .about-why__media img { height: 100%; object-position: center; }
  .about-why__copy h2 { margin-top: 0; }
  .about-why__copy ul { display: block; margin: 24px 0 0; padding: 0; list-style: none !important; }
  .about-why__copy li { padding: 14px 0; border-top: 1px solid var(--line); color: var(--muted); font-size: clamp(1.04rem, 1.28vw, 1.18rem); line-height: 1.42; }
  .about-why__copy li:last-child { border-bottom: 1px solid var(--line); }
  .about-why__image { aspect-ratio: 4 / 5; height: auto; max-height: 560px; }
  .about-section--unfold { margin-top: clamp(106px, 11vw, 148px); padding-bottom: clamp(14px, 2vw, 26px); }
  .about-section--unfold > header { display: block; max-width: 820px; }
  .about-section--unfold > header h2 { margin-bottom: 14px; }
  .about-section--unfold > header p { max-width: 680px; margin: 0; }
  .about-unfold__body { margin-top: clamp(16px, 2.2vw, 26px); }
  .about-unfold__chapter { display: grid; grid-template-columns: minmax(210px, .34fr) minmax(0, 1fr); gap: clamp(34px, 6vw, 80px); padding: clamp(12px, 2vw, 20px) 0; }
  .about-unfold__chapter + .about-unfold__chapter { margin-top: clamp(4px, 1vw, 12px); }
  .about-unfold__intro { max-width: 310px; }
  .about-unfold__intro h3 { margin: 0 0 12px; color: var(--ink); font-family: var(--font-serif); font-size: clamp(1.45rem, 2.1vw, 2rem); font-weight: 400; letter-spacing: 0; line-height: 1.12; text-transform: none; }
  .about-unfold__intro p { max-width: 310px; margin: 0; color: var(--muted); font-size: .92rem; line-height: 1.48; }
  .about-entry-points { margin: 0; padding: 0; list-style: none; }
  .about-entry-points li { display: grid; grid-template-columns: 38px minmax(190px, .8fr) minmax(240px, 1.2fr); gap: 18px; align-items: baseline; padding: 12px 0; }
  .about-entry-points li + li { border-top: 1px solid rgba(154, 126, 116, .22); }
  .about-entry-points li:first-child { padding-top: 0; }
  .about-entry-points__number, .about-week-flow__number { color: var(--accent-muted); font-size: .72rem; font-weight: 680; letter-spacing: .08em; }
  .about-entry-points__name { color: var(--ink); font-family: var(--font-serif); font-size: clamp(1.15rem, 1.8vw, 1.45rem); }
  .about-entry-points__text { color: var(--muted); font-size: .93rem; line-height: 1.4; }
  .about-day-arc { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(26px, 4vw, 58px); }
  .about-day-arc article { min-height: 220px; padding-top: 18px; border-top: 1px solid var(--line); }
  .about-day-arc__number { display: inline-block; margin-right: 12px; color: var(--accent-muted); font-size: .72rem; font-weight: 680; letter-spacing: .08em; }
  .about-day-arc__time { color: var(--accent-muted); font-size: .72rem; font-weight: 680; letter-spacing: .08em; text-transform: uppercase; }
  .about-day-arc h4 { margin: 20px 0 10px; color: var(--ink); font-family: var(--font-serif); font-size: clamp(1.2rem, 2vw, 1.62rem); font-weight: 400; line-height: 1.12; }
  .about-day-arc p { min-height: 42px; margin: 0; color: var(--muted); font-size: .92rem; line-height: 1.42; }
  .about-day-arc ul { display: grid; gap: 6px; margin: 18px 0 0; padding: 0; list-style: none; }
  .about-day-arc li { position: relative; padding: 2px 0 2px 14px; color: var(--ink); font-size: .9rem; line-height: 1.35; }
  .about-day-arc li::before { content: ""; position: absolute; left: 0; top: .86em; width: 3px; height: 3px; border-radius: 999px; background: var(--accent-muted); opacity: .72; }
  .about-festival-film { width: 100%; padding-top: clamp(4px, 1vw, 12px); }
  .about-festival-film__media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #111; }
  .about-festival-film__media iframe { position: absolute; inset: 0; display: block; width: 100%; height: 100%; border: 0; }
  .about-festival-film .about-unfold__intro p:last-child { margin: 0; color: var(--muted); font-size: .92rem; }
  .about-section--who { display: grid; grid-template-columns: minmax(300px, .82fr) minmax(0, 1fr); gap: clamp(34px, 6vw, 86px); align-items: stretch; }
  .about-who__copy { max-width: 560px; }
  .about-who__copy > p { margin: 0 0 26px; line-height: 1.52; }
  .about-who__copy ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 24px; margin: 0; padding: 0; list-style: none; }
  .about-who__copy li { padding: 0; color: var(--muted); font-size: .98rem; line-height: 1.52; }
  .about-who__media { justify-self: end; width: min(100%, 680px); height: clamp(480px, 38vw, 590px); aspect-ratio: auto; }
  .about-who__media img { height: 100%; object-position: center 46%; }
  .about-who__entry { max-width: 600px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line); }
  .about-who__entry h3 { margin-bottom: 10px; font-size: .88rem; }
  .about-who__entry p { line-height: 1.55; }
  .about-who__entry p { margin-bottom: 0; }
  .about-section--city { display: grid; grid-template-columns: minmax(360px, 1.1fr) minmax(280px, .9fr); gap: clamp(34px, 8vw, 122px); align-items: start; margin-top: clamp(72px, 8vw, 96px); padding-top: clamp(18px, 4vw, 54px); }
  .about-section--city h2 { margin-bottom: 26px; }
  .about-section--city img { aspect-ratio: 3 / 2; max-height: min(680px, 72vh); }
  .about-section--organisers { margin-bottom: clamp(46px, 6vw, 78px); padding-top: clamp(12px, 3vw, 38px); }
  .about-organisers__layout { display: grid; grid-template-columns: minmax(280px, .95fr) minmax(320px, 1.05fr); gap: clamp(34px, 7vw, 106px); align-items: stretch; }
  .about-organisers__copy { max-width: 620px; padding-bottom: 24px; border-bottom: 1px solid var(--line); }
  .about-organisers__groups { display: grid; gap: 20px; margin-top: clamp(24px, 3.2vw, 34px); }
  .about-organisers__group { display: grid; grid-template-columns: 1fr; gap: 11px; padding-top: 15px; border-top: 1px solid var(--line); }
  .about-organisers__group-title { margin: 0; color: var(--accent-muted); font-size: .68rem; letter-spacing: .075em; line-height: 1.35; }
  .about-organisers__items { display: grid; gap: 13px; }
  .about-organisers__item { margin: 0; color: var(--ink); font-size: .96rem; font-weight: 520; line-height: 1.36; }
  .about-organisers__group:nth-child(n + 2) .about-organisers__item { color: var(--muted); font-weight: 500; }
  .about-organisers__link { color: inherit; text-decoration: none; }
  .about-organisers__link:hover, .about-organisers__link:focus-visible { color: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .18em; }
  .about-organisers__role { display: block; margin-top: 4px; color: var(--muted); font-size: .92em; font-weight: 400; line-height: 1.42; }
  .about-organisers__media { align-self: stretch; width: 100%; height: 100%; max-height: none; margin-top: 0; aspect-ratio: auto; }
  .about-organisers__media img { height: 100%; object-position: center; }
  .about-practical { display: grid; grid-template-columns: minmax(260px, .9fr) minmax(310px, 1.1fr); gap: clamp(42px, 7vw, 92px); margin-top: clamp(58px, 7vw, 86px); padding: clamp(34px, 5vw, 58px) 0; border-bottom: 1px solid var(--line); }
  .about-practical .about-section { margin: 0; }
  .about-practical h2 { margin-top: 0; }
  .about-actions, .about-explore nav { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 25px; }
  .about-action, .about-explore nav a { color: var(--accent-muted); font-weight: 650; text-decoration: none; text-underline-offset: .25em; }
  .about-action { display: inline-flex; align-items: center; min-height: 38px; }
  .about-action--primary { padding: 10px 14px; background: var(--accent-muted); color: var(--paper); }
  .about-action:hover, .about-explore nav a:hover { color: var(--ink); text-decoration: underline; }
  .about-action--pending { color: var(--soft); cursor: default; }
  .about-faq { border-top: 1px solid var(--line); }
  .about-faq details { border-bottom: 1px solid var(--line); }
  .about-faq summary { padding: 17px 28px 17px 0; color: var(--ink); font-size: 1.04rem; font-weight: 610; cursor: pointer; }
  .about-faq summary:hover { background: rgba(145, 106, 94, .07); color: var(--accent-muted); }
  .about-faq summary:focus-visible { background: rgba(145, 106, 94, .07); color: var(--accent-muted); outline: 0; box-shadow: inset 0 0 0 1px var(--accent-muted); }
  .about-faq summary::marker { color: var(--accent-muted); }
  .about-faq p { margin: 0 0 16px; }
  .about-explore { display: grid; gap: 32px; margin-top: clamp(58px, 7vw, 86px); padding-bottom: 72px; }
  .about-explore img { aspect-ratio: 3 / 2; object-position: center; }
  .about-explore > div { display: block; }
  .about-explore nav { margin-top: 18px; gap: 14px 30px; font-size: 1.02rem; }
  .about-explore nav a:first-child { color: var(--ink); font-weight: 720; }
  @media (prefers-reduced-motion: reduce) { .about-hero video { display: none; } .about-hero__media { background: center / cover no-repeat url('/media/about/festival-closing.jpg'); } }
  @media (max-width: 680px) {
    .about-page { width: min(100% - 32px, 620px); padding-top: 36px; }
    .about-hero { margin-bottom: 54px; } .about-hero video, .about-hero__media { aspect-ratio: 16 / 9; }
    .about-section { margin: 68px 0; }
    .about-section--what, .about-section--unfold > header, .about-section--day, .about-section--who, .about-section--city, .about-explore, .about-practical { grid-template-columns: 1fr; gap: 28px; }
    .about-section--what > .about-media--landscape { max-height: 75vh; }
    .about-why__layout { grid-template-columns: 1fr; gap: 28px; }
    .about-why__copy h2 { margin-bottom: 0; }
    .about-why__copy ul { margin-top: 18px; }
    .about-why__copy li { padding: 14px 0; }
    .about-unfold__body { margin-top: 24px; }
    .about-unfold__chapter { grid-template-columns: 1fr; gap: 20px; padding: 22px 0; }
    .about-unfold__intro { max-width: 100%; }
    .about-unfold__intro p { max-width: 620px; }
    .about-entry-points li { grid-template-columns: 30px 1fr; gap: 8px 12px; padding: 13px 0; }
    .about-entry-points li:first-child { padding-top: 0; }
    .about-entry-points__text { grid-column: 2; }
    .about-day-arc { grid-template-columns: 1fr; gap: 22px; }
    .about-day-arc article { min-height: 0; padding: 18px 0 0; }
    .about-day-arc h4 { margin-top: 22px; }
    .about-day-arc p { min-height: 0; }
    .about-who__entry { grid-column: auto; }
    .about-who__copy ul { grid-template-columns: 1fr; gap: 7px; }
    .about-who__media { justify-self: stretch; width: 100%; max-height: none; }
    .about-who__media img { height: auto; }
    .about-practical { padding: 36px 0; }
    .about-organisers__layout { grid-template-columns: 1fr; gap: 28px; }
    .about-organisers__copy { padding-bottom: 0; border-bottom: 0; }
    .about-organisers__group { gap: 12px; }
    .about-organisers__media { margin-top: 0; max-height: none; }
    .about-organisers__media { max-height: none; }
    .about-organisers__media img { height: auto; }
    .about-explore { margin-top: 76px; }
  }
