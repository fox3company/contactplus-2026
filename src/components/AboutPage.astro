---
import { aboutCopy, aboutMedia } from '../lib/about';
import type { Locale } from '../lib/locales';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const copy = aboutCopy[lang];
const registrationUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSdkDT1NjKXxzbAg_8dqSLEDnYPstOaBZ8oE6mxqNHkLTUbBlg/viewform?usp=header';
const vimeoPlayerUrl = 'https://player.vimeo.com/video/672667748';
const organisers = [
  { names: ['Alexandra Soshnicova', 'Sergey Golovnea'], links: ['https://www.facebook.com/alexandra.soshnicova', 'https://www.facebook.com/golovnea'], role: copy.organisers.dance },
  { names: ['Anriana Celan'], links: ['https://www.facebook.com/adriana.celan'], role: copy.organisers.manager },
  { names: ['Moldova Festival Contact+'], links: ['https://www.facebook.com/fest.contactplus'], role: '' },
  { names: [copy.organisers.community], links: ['https://www.facebook.com/contempdance/'], role: '' },
  { names: ['Stan Potoku'], links: ['https://www.facebook.com/stanpotoku'], role: copy.organisers.musician },
  { names: ['Olyga Braga', 'Tara Diamondbreath'], links: ['https://www.facebook.com/oliga.braga', 'https://www.facebook.com/bodhi.tara'], role: copy.organisers.support },
];
const flowAlts = [
  'People arriving and meeting at a festival',
  'People practising Contact Improvisation together',
  'Performer moving in a theatre space',
  'Two performers in close stage work',
  'People sharing attention in a performance space',
  'People together during an evening gathering',
];
---

<main class="about-page">
  <header class="about-hero">
    <div class="about-hero__copy">
      <p class="eyebrow">{copy.strapline}</p>
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
      <p class="about-hero__facts">{copy.date}<span aria-hidden="true">·</span>{copy.place}</p>
    </div>
    <div class="about-hero__media">
      <video data-autoplay-video autoplay muted loop playsinline preload="metadata" poster={aboutMedia.heroPoster} aria-label={copy.video.heroLabel}>
        <source src={aboutMedia.heroVideo} type="video/mp4" />
      </video>
    </div>
  </header>

  <section class="about-section about-section--what" aria-labelledby="about-what">
    <div class="about-section__text"><p class="eyebrow">Contact+</p><h2 id="about-what">{copy.what.title}</h2><p class="about-section__lead">{copy.what.text}</p></div>
    <img src={aboutMedia.what} alt="A person close to the floor in a shared movement practice" width="2048" height="1365" loading="lazy" decoding="async" />
  </section>

  <section class="about-section about-section--why" aria-labelledby="about-why">
    <header><p class="eyebrow">Contact+</p><h2 id="about-why">{copy.why.title}</h2></header>
    <div class="about-why__stage">
      <p class="about-why__statement about-why__statement--one">{copy.why.items[0]}</p>
      <img class="about-why__image about-why__image--one" src={aboutMedia.why[0]} alt="A performer moving on stage" width="4000" height="6000" loading="lazy" decoding="async" />
      <p class="about-why__statement about-why__statement--two">{copy.why.items[1]}</p>
      <img class="about-why__image about-why__image--two" src={aboutMedia.why[1]} alt="Two people performing together on stage" width="4000" height="6000" loading="lazy" decoding="async" />
      <p class="about-why__statement about-why__statement--three">{copy.why.items[2]}</p>
      <img class="about-why__image about-why__image--three" src={aboutMedia.why[2]} alt="People meeting and moving together outdoors" width="2048" height="1365" loading="lazy" decoding="async" />
      <p class="about-why__statement about-why__statement--four">{copy.why.items[3]}</p>
      <p class="about-why__statement about-why__statement--five">{copy.why.items[4]}</p>
    </div>
  </section>

  <section class="about-section about-section--unfold" aria-labelledby="about-unfold">
    <header><p class="eyebrow">Contact+</p><h2 id="about-unfold">{copy.unfold.title}</h2><p>{copy.unfold.text}</p></header>
    <ul class="about-dimensions">{copy.unfold.dimensions.map((item: string) => <li>{item}</li>)}</ul>
    <ol class="about-flow">{copy.unfold.flow.map((item: string) => <li>{item}</li>)}</ol>
    <div class="about-flow-gallery">{aboutMedia.flow.map((src, index) => <img src={src} alt={flowAlts[index]} width="2048" height="1367" loading="lazy" decoding="async" />)}</div>
  </section>

  <section class="about-section about-section--day" aria-labelledby="about-day">
    <div class="about-day__media">
      <video controls playsinline preload="metadata" poster={aboutMedia.dayPoster} aria-label={copy.day.title}>
        <source src={aboutMedia.dayVideo} type="video/mp4" />
      </video>
      <button class="about-vimeo" type="button" data-vimeo-trigger data-vimeo-url={vimeoPlayerUrl} aria-label={copy.video.vimeoLabel}>{copy.video.vimeoLabel}</button>
      <div class="about-vimeo__frame" data-vimeo-frame></div>
    </div>
    <div class="about-day__copy"><p class="eyebrow">Contact+</p><h2 id="about-day">{copy.day.title}</h2><p>{copy.day.note}</p><ol class="about-day__list">{copy.day.items.map((item: string) => <li>{item}</li>)}</ol></div>
  </section>

  <section class="about-section about-section--who" aria-labelledby="about-who">
    <div class="about-who__copy"><p class="eyebrow">Contact+</p><h2 id="about-who">{copy.who.title}</h2><h3>{copy.who.gathering}</h3><ul>{copy.who.groups.map((item: string) => <li>{item}</li>)}</ul></div>
    <div class="about-who__media"><img src={aboutMedia.who[0]} alt="A large group sharing movement in an open space" width="2048" height="1367" loading="lazy" decoding="async" /><img src={aboutMedia.who[1]} alt="People moving together in a performance setting" width="4000" height="6000" loading="lazy" decoding="async" /></div>
    <div class="about-who__entry"><h3>{copy.who.entry}</h3><p>{copy.who.entryText}</p></div>
  </section>

  <section class="about-section about-section--city" aria-labelledby="about-city"><img src={aboutMedia.city} alt="People moving together outdoors in Chișinău" width="2048" height="1367" loading="lazy" decoding="async" /><div><p class="eyebrow">Chișinău</p><h2 id="about-city">{copy.city.title}</h2><p>{copy.city.text}</p></div></section>

  <section class="about-section about-section--organisers" aria-labelledby="about-organisers"><p class="eyebrow">Contact+</p><h2 id="about-organisers">{copy.organisers.title}</h2><p class="about-section__lead">{copy.organisers.intro}</p><div class="about-organisers__list">{organisers.map((organiser) => <p><span>{organiser.names.map((name, index) => <><a href={organiser.links[index]} rel="noopener" target="_blank">{name}</a>{index < organiser.names.length - 1 && ', '}</>)}</span>{organiser.role && <small> — {organiser.role}</small>}</p>)}</div></section>

  <section class="about-practical" id="passes-participation"><section class="about-section about-section--participation" aria-labelledby="about-participation"><p class="eyebrow">Contact+</p><h2 id="about-participation">{copy.participation.title}</h2><p>{copy.participation.text}</p><div class="about-actions"><a class="about-action about-action--pending" href="#" aria-disabled="true" data-passes-placeholder>{copy.participation.passes}</a><a class="about-action" href={registrationUrl} rel="noopener" target="_blank">{copy.participation.register}</a></div></section><section class="about-section about-section--faq" aria-labelledby="about-faq"><h2 id="about-faq">{copy.faqTitle}</h2><div class="about-faq">{copy.faq.map(([question, answer]: [string, string]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section></section>

  <section class="about-explore" aria-labelledby="about-explore"><img src={aboutMedia.closing} alt="A group of performers sharing a vivid stage moment" width="3600" height="2384" loading="lazy" decoding="async" /><div><p class="eyebrow">Contact+</p><h2 id="about-explore">{copy.explore.title}</h2><nav aria-label={copy.explore.title}><a href={`/${lang}/program`}>{copy.explore.program}</a><a href={`/${lang}/schedule`}>{copy.explore.schedule}</a><a href={`/${lang}/artists`}>{copy.explore.artists}</a></nav></div></section>
</main>

<script is:inline>
  document.querySelector('[data-passes-placeholder]')?.addEventListener('click', (event) => event.preventDefault());
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll('[data-autoplay-video]').forEach((video) => {
    if (reduceMotion.matches) {
      video.removeAttribute('autoplay');
      video.pause();
    }
  });
  document.querySelectorAll('[data-vimeo-trigger]').forEach((button) => {
    button.addEventListener('click', () => {
      const frame = button.parentElement?.querySelector('[data-vimeo-frame]');
      if (!frame || frame.querySelector('iframe')) return;
      const iframe = document.createElement('iframe');
      iframe.src = `${button.dataset.vimeoUrl}?autoplay=1&title=0&byline=0&portrait=0`;
      iframe.title = button.getAttribute('aria-label') || 'Vimeo video';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;
      frame.append(iframe);
      button.hidden = true;
    });
  });
</script>

<style>
  .about-page { width: min(1240px, calc(100% - 40px)); margin: 0 auto; padding: clamp(40px, 6vw, 80px) 0 clamp(54px, 8vw, 100px); }
  .about-hero { margin-bottom: clamp(46px, 7vw, 92px); }
  .about-hero__copy { max-width: 810px; margin-bottom: clamp(26px, 4vw, 54px); }
  .about-hero h1 { max-width: 760px; margin: 12px 0 18px; }
  .about-hero__facts { display: flex; flex-wrap: wrap; gap: 7px; margin: 24px 0 0; color: var(--accent-muted); font-size: .78rem; font-weight: 650; letter-spacing: .07em; text-transform: uppercase; }
  .about-hero__media, .about-day__media { position: relative; overflow: hidden; background: #222; }
  .about-hero video, .about-day video { display: block; width: 100%; object-fit: cover; }
  .about-hero video { aspect-ratio: 2.15; object-position: center; }
  .about-section { margin: clamp(62px, 9vw, 118px) 0; }
  .about-section h2, .about-explore h2 { max-width: 680px; margin: 8px 0 20px; font-family: var(--font-serif); font-size: clamp(2rem, 3.8vw, 3.35rem); font-weight: 400; line-height: 1.08; }
  .about-section h3 { margin: 26px 0 12px; font-size: .82rem; letter-spacing: .07em; text-transform: uppercase; }
  .about-section p { max-width: 660px; color: var(--muted); }
  .about-section__lead { font-size: clamp(1.14rem, 1.9vw, 1.45rem); line-height: 1.56; }
  .about-section img, .about-explore img { display: block; width: 100%; object-fit: cover; }
  .about-section--what { display: grid; grid-template-columns: minmax(280px, .9fr) minmax(360px, 1.1fr); gap: clamp(34px, 8vw, 122px); align-items: end; }
  .about-section--what img { aspect-ratio: 1.42; object-position: center; }
  .about-section--why { margin-top: clamp(72px, 10vw, 140px); }
  .about-why__stage { display: grid; grid-template-columns: 1.1fr .9fr .85fr; grid-template-rows: auto auto auto; gap: clamp(18px, 2.6vw, 38px); align-items: end; }
  .about-why__statement { margin: 0; color: var(--ink); font-family: var(--font-serif); font-size: clamp(1.45rem, 2.65vw, 2.42rem); line-height: 1.12; }
  .about-why__statement--one { grid-column: 1 / 3; max-width: 530px; }
  .about-why__image--one { grid-column: 3; grid-row: 1 / 3; aspect-ratio: .66; object-position: center; }
  .about-why__statement--two { grid-column: 1; }
  .about-why__image--two { grid-column: 2; grid-row: 2 / 4; aspect-ratio: .66; object-position: center; }
  .about-why__statement--three { grid-column: 1; }
  .about-why__image--three { grid-column: 3; aspect-ratio: 1.25; }
  .about-why__statement--four { grid-column: 1 / 3; max-width: 620px; }
  .about-why__statement--five { grid-column: 3; font-size: clamp(1.15rem, 1.8vw, 1.72rem); }
  .about-section--unfold { margin-top: clamp(88px, 13vw, 170px); }
  .about-section--unfold > header { display: grid; grid-template-columns: minmax(260px, .7fr) minmax(300px, 1.3fr); gap: clamp(28px, 8vw, 122px); align-items: end; }
  .about-section--unfold > header h2 { margin-bottom: 0; }
  .about-section--unfold > header p { margin: 0; }
  .about-dimensions { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 42px 0 0; padding: 0; list-style: none; color: var(--accent-muted); font-family: var(--font-serif); font-size: clamp(1.12rem, 2vw, 1.7rem); line-height: 1.15; }
  .about-flow { display: flex; flex-wrap: wrap; gap: 8px 0; margin: 35px 0 30px; padding: 0; list-style: none; color: var(--ink); font-family: var(--font-serif); font-size: clamp(1.2rem, 2.25vw, 1.9rem); }
  .about-flow li:not(:last-child)::after { margin: 0 12px; color: var(--line-strong); content: '→'; }
  .about-flow-gallery { display: grid; grid-template-columns: 1.35fr .85fr 1.05fr .75fr 1.15fr .9fr; gap: 8px; }
  .about-flow-gallery img { height: clamp(190px, 23vw, 310px); }
  .about-flow-gallery img:nth-child(2), .about-flow-gallery img:nth-child(4) { object-position: center; }
  .about-section--day { display: grid; grid-template-columns: minmax(390px, 1.16fr) minmax(280px, .84fr); gap: clamp(30px, 7vw, 100px); align-items: center; margin-top: clamp(94px, 14vw, 180px); }
  .about-day video { aspect-ratio: 1.42; }
  .about-vimeo { position: absolute; right: 14px; bottom: 14px; padding: 10px 13px; border: 1px solid rgba(251,250,247,.72); background: rgba(36,33,31,.78); color: var(--paper); font: inherit; font-size: .78rem; cursor: pointer; }
  .about-vimeo:hover, .about-vimeo:focus-visible { background: var(--accent); outline: 2px solid var(--paper); outline-offset: 2px; }
  .about-vimeo__frame:empty { display: none; }
  .about-vimeo__frame { position: absolute; inset: 0; }
  .about-vimeo__frame iframe { width: 100%; height: 100%; border: 0; }
  .about-day__copy > p { margin-bottom: 28px; }
  .about-day__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .about-day__list li { padding: 11px 0; border-bottom: 1px solid var(--line); color: var(--ink); }
  .about-section--who { display: grid; grid-template-columns: minmax(250px, .76fr) minmax(360px, 1.24fr); gap: clamp(30px, 7vw, 104px); }
  .about-who__copy ul { margin: 0; padding: 0; list-style: none; }
  .about-who__copy li { padding: 7px 0; color: var(--muted); }
  .about-who__media { display: grid; grid-template-columns: 1.4fr .6fr; gap: 12px; align-items: end; }
  .about-who__media img:first-child { aspect-ratio: 1.35; }
  .about-who__media img:last-child { aspect-ratio: .62; object-position: center 40%; }
  .about-who__entry { grid-column: 2; max-width: 600px; }
  .about-who__entry p { margin-bottom: 0; }
  .about-section--city { display: grid; grid-template-columns: minmax(320px, 1.08fr) minmax(260px, .92fr); gap: clamp(34px, 8vw, 118px); align-items: center; }
  .about-section--city img { aspect-ratio: 1.35; }
  .about-section--organisers { max-width: 860px; margin-bottom: clamp(52px, 7vw, 94px); }
  .about-organisers__list { max-width: 700px; margin-top: 24px; }
  .about-organisers__list p { margin: 0 0 9px; color: var(--ink); }
  .about-organisers__list a { color: inherit; text-decoration-color: var(--line-strong); text-underline-offset: .2em; }
  .about-organisers__list small { color: var(--muted); font-size: .92em; }
  .about-practical { display: grid; grid-template-columns: minmax(260px, .85fr) minmax(310px, 1.15fr); gap: clamp(42px, 8vw, 120px); padding: clamp(34px, 5vw, 66px) 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .about-practical .about-section { margin: 0; }
  .about-actions, .about-explore nav { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 25px; }
  .about-action, .about-explore nav a { color: var(--accent-muted); font-weight: 650; text-decoration: none; text-underline-offset: .25em; }
  .about-action:hover, .about-explore nav a:hover { color: var(--ink); text-decoration: underline; }
  .about-action--pending { color: var(--soft); cursor: default; }
  .about-faq { border-top: 1px solid var(--line); }
  .about-faq details { border-bottom: 1px solid var(--line); }
  .about-faq summary { padding: 15px 28px 15px 0; color: var(--ink); font-weight: 610; cursor: pointer; }
  .about-faq summary::marker { color: var(--accent-muted); }
  .about-faq p { margin: 0 0 16px; }
  .about-explore { display: grid; grid-template-columns: minmax(340px, 1.15fr) minmax(250px, .85fr); gap: clamp(34px, 8vw, 120px); align-items: center; margin-top: clamp(74px, 11vw, 146px); }
  .about-explore img { aspect-ratio: 1.65; object-position: center; }
  @media (prefers-reduced-motion: reduce) { .about-hero video { display: none; } .about-hero__media { aspect-ratio: 2.15; background: center / cover no-repeat url('/media/about/festival-closing.jpg'); } }
  @media (max-width: 760px) {
    .about-page { width: min(100% - 32px, 620px); padding-top: 36px; }
    .about-hero { margin-bottom: 54px; } .about-hero video, .about-hero__media { aspect-ratio: 1.1; }
    .about-section { margin: 68px 0; }
    .about-section--what, .about-section--unfold > header, .about-section--day, .about-section--who, .about-section--city, .about-explore, .about-practical { grid-template-columns: 1fr; gap: 28px; }
    .about-section--what img { aspect-ratio: 1.08; }
    .about-why__stage { grid-template-columns: 1fr 1fr; gap: 16px; }
    .about-why__statement--one, .about-why__statement--two, .about-why__statement--three, .about-why__statement--four, .about-why__statement--five, .about-why__image--one, .about-why__image--two, .about-why__image--three { grid-column: auto; grid-row: auto; }
    .about-why__statement--one, .about-why__statement--four { grid-column: 1 / -1; }
    .about-why__image--one, .about-why__image--two { aspect-ratio: .7; }
    .about-why__image--three { grid-column: 1 / -1; aspect-ratio: 1.28; }
    .about-dimensions { grid-template-columns: repeat(2, 1fr); margin-top: 28px; }
    .about-flow { margin: 28px 0 22px; font-size: 1.25rem; }
    .about-flow-gallery { grid-template-columns: 1fr 1fr; gap: 8px; }
    .about-flow-gallery img { height: 190px; } .about-flow-gallery img:nth-child(3) { grid-column: 1 / -1; height: 240px; }
    .about-section--day { margin-top: 92px; } .about-day video { aspect-ratio: 1.12; }
    .about-who__entry { grid-column: auto; } .about-who__media img:first-child { aspect-ratio: 1.12; }
    .about-section--city img { aspect-ratio: 1.14; } .about-practical { padding: 36px 0; }
    .about-explore { margin-top: 76px; } .about-explore img { aspect-ratio: 1.1; }
  }
</style>
