---
interface Props {
  title: string;
  label?: string;
  caption?: string;
  src?: string;
  type?: 'image' | 'video';
}

const { title, label = 'Media', caption, src, type } = Astro.props;
const mediaType = type || (src?.match(/\.(mp4|mov|webm)$/i) ? 'video' : 'image');
---

<figure class="media-block">
  {src && mediaType === 'video' ? (
    <video class="surface" controls playsinline preload="metadata" src={src} aria-label={title}></video>
  ) : src ? (
    <img class="surface" src={src} alt={title} loading="lazy" />
  ) : (
    <div class="surface" aria-hidden="true">
      <span>{label}</span>
    </div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .media-block {
    max-width: 920px;
    margin: clamp(42px, 7vw, 70px) 0;
  }

  .surface {
    display: grid;
    width: 100%;
    min-height: clamp(180px, 32vw, 360px);
    place-items: center;
    border: 1px solid var(--line);
    background: var(--paper-deep);
    box-shadow: inset 0 0 0 12px rgba(251, 250, 247, 0.38);
    object-fit: cover;
  }

  .surface span {
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  figcaption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
