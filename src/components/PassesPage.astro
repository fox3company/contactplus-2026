<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    const choice = document.querySelector('[data-jam-choice]');
    if (choice) {
      const buttons = [...choice.querySelectorAll('[data-jam-choice-button]')];
      const panels = [...document.querySelectorAll('[data-jam-panel]')];

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const selected = button.getAttribute('data-jam-choice-button');
          buttons.forEach((item) => item.setAttribute(
            'aria-pressed',
            String(item === button),
          ));
          panels.forEach((panel) => {
            panel.hidden = panel.getAttribute('data-jam-panel') !== selected;
          });
        });
      });
    }

    document.querySelectorAll('[data-option-chooser]').forEach((chooser) => {
      const tabs = [...chooser.querySelectorAll('[data-option-tab]')];
      const panels = [...chooser.querySelectorAll('[data-option-panel]')];

      const selectTab = (tab) => {
        const selected = tab.getAttribute('data-option-tab');
        const selectionCta = chooser.closest('.path-builder')?.querySelector('[data-selection-cta]');
        tabs.forEach((item) => {
          const active = item === tab;
          item.setAttribute('aria-selected', String(active));
          item.setAttribute('tabindex', active ? '0' : '-1');
        });
        panels.forEach((panel) => {
          panel.hidden = panel.getAttribute('data-option-panel') !== selected;
        });
        if (selectionCta && tab.dataset.ctaLabel) {
          selectionCta.textContent = tab.dataset.ctaLabel;
        }
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectTab(tab));
        tab.addEventListener('keydown', (event) => {
          let nextIndex = index;
          if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') nextIndex = 0;
          else if (event.key === 'End') nextIndex = tabs.length - 1;
          else return;
          event.preventDefault();
          selectTab(tabs[nextIndex]);
          tabs[nextIndex].focus();
        });
      });
    });

    document.querySelectorAll('.faq-list, .practical-groups').forEach((group) => {
      group.querySelectorAll('details').forEach((item) => {
        item.addEventListener('toggle', () => {
          if (!item.open) return;
          group.querySelectorAll('details[open]').forEach((openItem) => {
            if (openItem !== item) openItem.open = false;
          });
        });
      });
    });
  });
</script>

