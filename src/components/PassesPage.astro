---
import { getCollection } from 'astro:content';
import InclusionList from './InclusionList.astro';
import PricePair from './PricePair.astro';
import PassEventCard from './PassEventCard.astro';
import EventDetailPanel from './EventDetailPanel.astro';
import { getLocalized, type Locale } from '../lib/locales';
import { passesCopy, passesShared } from '../lib/passes';
import { buildEventDetails } from '../lib/eventDetails';
import { getProgramFilterGroup } from '../lib/program';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const copy = passesCopy[lang];
const events = await getCollection('events');
const people = await getCollection('people');
const eventsBySlug = new Map(events.map((event) => [event.slug, event]));
const eventDetails = buildEventDetails(events, people, lang);
const youthEvent = eventLink('youth-dance-class');

function eventLink(slug: string) {
  const event = eventsBySlug.get(slug);
  if (!event) return { title: slug, slug, accent: '', meta: '' };
  const category = event.data.meta?.category
    ? getLocalized(event.data.meta.category, lang)
    : '';
  const format = event.data.meta?.format
    ? getLocalized(event.data.meta.format, lang)
    : '';
  return {
    title: getLocalized(event.data.title, lang),
    slug,
    accent: getProgramFilterGroup(event),
    meta: format || category,
  };
}

const priceProps = {
  regularLabel: copy.pricing.regular,
  lateLabel: copy.pricing.late,
  regularNote: copy.pricing.regularNote,
  lateNote: copy.pricing.lateNote,
  ariaLabel: copy.pricing.label,
};

const ui = {
  choosePass: getLocalized({ en: 'Choose a pass', ro: 'Alege un abonament', ru: 'Выбрать абонемент' }, lang),
  heroShortLead: getLocalized({ en: 'Choose your way into Contact+.', ro: 'Alege cum vrei să participi la Contact+.', ru: 'Выберите свой путь в Contact+.' }, lang),
  goodToKnow: getLocalized({ en: 'Good to know', ro: 'Bine de știut', ru: 'Важно знать' }, lang),
  included: getLocalized({ en: 'Included', ro: 'Inclus', ru: 'Включено' }, lang),
  includedInPass: getLocalized({ en: 'Included in this pass', ro: 'Inclus în acest abonament', ru: 'Включено в этот абонемент' }, lang),
  alsoIncluded: getLocalized({ en: 'Also included', ro: 'Inclus și', ru: 'Также входит' }, lang),
  ageDetails: getLocalized({ en: 'Age guide', ro: 'Ghid de vârstă', ru: 'По возрасту' }, lang),
  viewDetails: getLocalized({ en: 'View event details', ro: 'Vezi detaliile evenimentului', ru: 'Посмотреть детали события' }, lang),
  openingCta: getLocalized({ en: 'Register for the Opening Weekend Pass', ro: 'Înscrie-te pentru Opening Weekend Pass', ru: 'Зарегистрироваться на Opening Weekend Pass' }, lang),
  ciChooserTitle: getLocalized({ en: 'Choose your CI format', ro: 'Alege formatul de Contact Improvisation', ru: 'Выберите формат Контактной импровизации' }, lang),
  labsChooserTitle: getLocalized({ en: 'Choose your Performance Lab format', ro: 'Alege formatul Performance Lab', ru: 'Выберите формат Performance Lab' }, lang),
  ciRegisterCtas: [
    getLocalized({ en: 'Register for the 3-day CI intensive', ro: 'Înscrie-te la intensivul IC de 3 zile', ru: 'Записаться на интенсив КИ на 3 дня' }, lang),
    getLocalized({ en: 'Register for Risk, Play & Flight', ro: 'Înscrie-te la Risk, Play & Flight', ru: 'Записаться на Risk, Play & Flight' }, lang),
    getLocalized({ en: 'Register for both CI parts', ro: 'Înscrie-te la ambele etape IC', ru: 'Записаться на обе части КИ' }, lang),
  ],
  labsRegisterCtas: [
    getLocalized({ en: 'Register for the 3-day Performance Lab', ro: 'Înscrie-te la Performance Lab de 3 zile', ru: 'Записаться на Performance Lab на 3 дня' }, lang),
    getLocalized({ en: 'Register for Seeing and being seen', ro: 'Înscrie-te la Seeing and being seen', ru: 'Записаться на Seeing and being seen' }, lang),
    getLocalized({ en: 'Register for both Performance Labs', ro: 'Înscrie-te la ambele Performance Labs', ru: 'Записаться на обе Performance Labs' }, lang),
  ],
  jamTitle: getLocalized({ en: 'Join one or more JAMs', ro: 'Participă la unul sau mai multe JAM-uri', ru: 'Присоединитесь к одному или нескольким JAM-ам' }, lang),
  jamQuestion: copy.jams.choiceTitle,
  jamPriceTitle: getLocalized({ en: 'Your JAM price', ro: 'Tariful tău JAM', ru: 'Ваш тариф JAM' }, lang),
  optionLabel: getLocalized({ en: 'Option', ro: 'Opțiune', ru: 'Вариант' }, lang),
  jamNo: copy.jams.generalChoice,
  jamYes: copy.jams.participantChoice,
  jamDates: getLocalized({ en: 'View 6 JAM dates', ro: 'Vezi cele 6 date JAM', ru: 'Посмотреть 6 дат JAM' }, lang),
  hideJamDates: getLocalized({ en: 'Hide JAM dates', ro: 'Ascunde datele JAM', ru: 'Скрыть даты JAM' }, lang),
  jamCta: getLocalized({ en: 'Register for JAMs', ro: 'Înscrie-te la JAM-uri', ru: 'Записаться на JAM-ы' }, lang),
  familyChooserTitle: getLocalized({ en: 'Choose a family or youth format', ro: 'Alege un format pentru familie sau tineri', ru: 'Выберите семейный или молодёжный формат' }, lang),
  includedFormat: getLocalized({ en: 'Included format', ro: 'Format inclus', ru: 'Включённый формат' }, lang),
  familyPassCta: getLocalized({ en: 'Register for the Family Pass', ro: 'Înscrie-te pentru Family Pass', ru: 'Зарегистрироваться на Family Pass' }, lang),
  youthCta: getLocalized({ en: 'Register for Youth Dance Class', ro: 'Înscrie-te pentru Youth Dance Class', ru: 'Зарегистрироваться на Youth Dance Class' }, lang),
  addFamily: getLocalized({ en: 'Add another family member', ro: 'Adaugă un membru al familiei', ru: 'Добавить члена семьи' }, lang),
  optional: getLocalized({ en: 'Optional add-on', ro: 'Opțiune suplimentară', ru: 'Дополнительная опция' }, lang),
  ciShortNote: getLocalized({ en: 'Not included: JAMs and shared practices.', ro: 'Nu sunt incluse: JAM-urile și practicile comune.', ru: 'Не включены: JAM-ы и общие практики.' }, lang),
  labsShortNote: getLocalized({ en: 'Showings included · No application required.', ro: 'Prezentările sunt incluse · Nu este necesară înscrierea prin selecție.', ru: 'Показы включены · Отбор не требуется.' }, lang),
  performancesShort: getLocalized({
    en: 'Sold separately through the festival ticket platform.',
    ro: 'Se vând separat prin platforma de bilete a festivalului.',
    ru: 'Продаются отдельно на билетной платформе фестиваля.',
  }, lang),
  performancesTitle: getLocalized({ en: 'Performance tickets', ro: 'Bilete la performance-uri', ru: 'Билеты на перформансы' }, lang),
  registrationTitle: getLocalized({ en: 'How registration works', ro: 'Cum funcționează înscrierea', ru: 'Как проходит регистрация' }, lang),
  registrationSteps: [
    [getLocalized({ en: 'Choose your format', ro: 'Alege formatul', ru: 'Выберите формат' }, lang), getLocalized({ en: 'Choose the participation path that fits you.', ro: 'Alege forma de participare potrivită pentru tine.', ru: 'Выберите подходящий путь участия.' }, lang)],
    [getLocalized({ en: 'Submit one registration form', ro: 'Trimite un singur formular', ru: 'Отправьте одну регистрационную форму' }, lang), getLocalized({ en: 'Indicate your format, event choice and selected JAMs.', ro: 'Indică formatul, evenimentul ales și JAM-urile selectate.', ru: 'Укажите формат, выбранное событие и JAM-ы.' }, lang)],
    [getLocalized({ en: 'Confirm availability and payment', ro: 'Confirmă disponibilitatea și plata', ru: 'Подтвердите наличие места и оплату' }, lang), getLocalized({ en: 'The team confirms your place, sends payment instructions and later shares practical information.', ro: 'Echipa confirmă locul, trimite instrucțiunile de plată și apoi informațiile practice.', ru: 'Команда подтверждает место, присылает инструкции по оплате, а затем практическую информацию.' }, lang)],
  ],
  practicalTitle: getLocalized({ en: 'Before you register', ro: 'Înainte de înscriere', ru: 'Перед регистрацией' }, lang),
  practicalGroups: [
    getLocalized({ en: 'Participation rules', ro: 'Reguli de participare', ru: 'Правила участия' }, lang),
    getLocalized({ en: 'Registration and payment', ro: 'Înscriere și plată', ru: 'Регистрация и оплата' }, lang),
    getLocalized({ en: 'Support and cancellations', ro: 'Sprijin și anulări', ru: 'Поддержка и отмена' }, lang),
  ],
  faqTitle: getLocalized({ en: 'Frequently asked questions', ro: 'Întrebări frecvente', ru: 'Частые вопросы' }, lang),
};
---

<main class="passes-page passes-page--system">
  <header class="passes-hero">
    <div class="passes-hero__main">
      <p class="eyebrow">{copy.strapline}</p>
      <h1>{copy.title}</h1>
      <p class="passes-hero__lead passes-hero__lead--full">{copy.lead}</p>
      <p class="passes-hero__lead passes-hero__lead--short">{ui.heroShortLead}</p>
      <p class="passes-hero__facts"><span class="passes-hero__date">{copy.date}<span class="passes-hero__dot" aria-hidden="true">·</span></span><span class="passes-hero__place">{copy.place}</span></p>
      <div class="passes-actions">
        <a class="passes-action passes-action--primary" href="#choose-path">{ui.choosePass}</a>
        <a class="passes-action passes-action--text" href={`/${lang}/program`}>{copy.actions.program} →</a>
      </div>
    </div>
  </header>

  <nav class="path-index" aria-labelledby="choose-path">
    <header><h2 id="choose-path">{copy.paths.title}</h2><p>{copy.paths.text}</p></header>
    <ol>
      {copy.paths.items.map(([id, label, meta, text]: [string, string, string, string], index: number) =>
        <li>
          <a href={`#${id}`}>
            <span class="path-index__number">0{index + 1}</span>
            <span class="path-index__label"><strong>{label}</strong><small>{meta}</small></span>
            <span class="path-index__best">{text}</span>
            <span class="path-index__arrow" aria-hidden="true">↓</span>
          </a>
        </li>
      )}
    </ol>
  </nav>

  <section class="full-pass section-wide" id="full-festival" aria-labelledby="full-festival-title">
    <div class="full-pass__top">
      <div class="full-pass__copy">
        <p class="section-kicker">{copy.full.kicker}</p>
        <h2 id="full-festival-title">{copy.full.title}</h2>
        <p class="section-lead">{copy.full.text}</p>
      </div>
      <div class="full-pass__purchase">
        <PricePair regular="€450" late="€550" {...priceProps} />
        <div class="passes-actions">
          <a class="passes-action passes-action--primary" href={passesShared.registrationUrl} rel="noopener" target="_blank">{copy.full.cta}</a>
          <a class="passes-action passes-action--text" href={`/${lang}/schedule`}>{copy.actions.schedule} →</a>
        </div>
      </div>
    </div>
    <div class="full-pass__bottom">
      <div>
        <h3>{copy.full.includesTitle}</h3>
        <InclusionList items={copy.full.includes.slice(0, 5)} />
      </div>
      <section class="full-pass__details" aria-labelledby="full-pass-notes-title">
        <h3 id="full-pass-notes-title">{ui.goodToKnow}</h3>
        <div class="editorial-notes editorial-notes--desktop">
          {[copy.full.parallel, copy.full.performances, copy.full.family].map((note: string, index: number) =>
            <div><h3>{copy.full.noteLabels[index]}</h3><p>{note}</p></div>
          )}
        </div>
        <details class="full-pass__mobile-notes">
          <summary>{ui.goodToKnow}</summary>
          <div class="editorial-notes">
            {[copy.full.parallel, copy.full.performances, copy.full.family].map((note: string, index: number) =>
              <div><h3>{copy.full.noteLabels[index]}</h3><p>{note}</p></div>
            )}
          </div>
        </details>
      </section>
    </div>
  </section>

  <section class="decision-section opening-package" id="opening" aria-labelledby="opening-title">
    <header class="decision-section__header">
      <div>
        <p class="section-kicker">01</p>
        <h2 id="opening-title">{copy.opening.title}</h2>
        <p class="section-lead">{copy.opening.text}</p>
      </div>
      <PricePair regular="€120" late="€150" {...priceProps} />
    </header>
    <div class="package-map">
      <h3>{copy.opening.packageTitle}</h3>
      <section class="package-map__step">
        <span class="package-map__number">1</span>
        <div>
          <h4>{copy.opening.chooseTitle}</h4>
          <div class="event-choice-grid">
            {passesShared.eventSlugs.opening.map((slug, index) => {
              const event = eventLink(slug);
              return (
                <PassEventCard
                  title={event.title}
                  meta={copy.opening.meta}
                  slug={event.slug}
                  accent={event.accent}
                  viewDetailsLabel={ui.viewDetails}
                  state="selectable"
                  inputName="opening-intensive"
                  checked={index === 0}
                />
              );
            })}
          </div>
          <p class="package-map__note">{copy.opening.unavailable}</p>
        </div>
      </section>
      <section class="package-map__step">
        <span class="package-map__number">2</span>
        <div>
          <h4>{copy.opening.includedTitle}</h4>
          <p>{copy.opening.includedText}</p>
          <div class="included-event-grid">
            {passesShared.eventSlugs.openingIncluded.map((slug) => {
              const event = eventLink(slug);
              return (
                <PassEventCard
                  title={event.title}
                  meta={event.meta || ui.includedInPass}
                  slug={event.slug}
                  accent={event.accent}
                  viewDetailsLabel={ui.viewDetails}
                  state="included"
                  status={ui.included}
                />
              );
            })}
          </div>
        </div>
      </section>
    </div>
    <footer class="decision-actions">
      <p>{copy.opening.selectionNote}</p>
      <a class="passes-action passes-action--primary" href={passesShared.registrationUrl} rel="noopener" target="_blank">{ui.openingCta}</a>
    </footer>
  </section>

  <section class="decision-section path-builder" id="ci" aria-labelledby="ci-title">
    <header class="decision-section__header decision-section__header--text">
      <div>
        <p class="section-kicker">02</p>
        <h2 id="ci-title">{copy.ci.title}</h2>
        <p class="section-lead">{copy.ci.intro}</p>
      </div>
    </header>
    <div class="interactive-choice" data-option-chooser>
      <div class="choice-prompt"><span>01</span><h3>{ui.ciChooserTitle}</h3></div>
      <div class="choice-tabs" role="tablist" aria-label={ui.ciChooserTitle}>
        {copy.ci.optionTitles.map((title: string, index: number) =>
          <button type="button" role="tab" id={`ci-tab-${index}`} aria-controls={`ci-panel-${index}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? '0' : '-1'} data-option-tab={String(index)} data-cta-label={ui.ciRegisterCtas[index]}>
            <span>0{index + 1}</span><strong>{title}</strong><small>{copy.ci.optionMeta[index]}</small>
          </button>
        )}
      </div>
      <select class="choice-select" data-option-select aria-label={ui.ciChooserTitle}>
        {copy.ci.optionTitles.map((title: string, index: number) =>
          <option value={String(index)}>{title}</option>
        )}
      </select>
      <div class="participation-options">
      <article class="participation-option" id="ci-panel-0" role="tabpanel" aria-labelledby="ci-tab-0" data-option-panel="0">
        <header><span>01</span><div><h3>{copy.ci.optionTitles[0]}</h3><p>{copy.ci.optionMeta[0]}</p></div></header>
        <div class="participation-option__content">
          <p>{copy.ci.optionNotes[0]}</p>
          <div class="participation-option__selection">
            <div class="event-choice-grid event-choice-grid--compact">
              {passesShared.eventSlugs.ciMain.map((slug, index) => {
                const event = eventLink(slug);
                return <PassEventCard title={event.title} meta={copy.ci.mainMeta} slug={event.slug} accent={event.accent} viewDetailsLabel={ui.viewDetails} state="selectable" inputName="ci-main" checked={index === 0} />;
              })}
            </div>
            <PricePair regular="€165" late="€215" compact {...priceProps} />
          </div>
        </div>
      </article>
      <article class="participation-option" id="ci-panel-1" role="tabpanel" aria-labelledby="ci-tab-1" data-option-panel="1" hidden>
        <header><span>02</span><div><h3>{copy.ci.optionTitles[1]}</h3><p>{copy.ci.optionMeta[1]}</p></div></header>
        <div class="participation-option__content">
          <p>{copy.ci.optionNotes[1]}</p>
          <div class="participation-option__selection">
            <div class="event-choice-grid event-choice-grid--compact">
              {(() => {
                const event = eventLink('risk-play-flight');
                return <PassEventCard title={event.title} meta={copy.ci.secondMeta} slug={event.slug} accent={event.accent} viewDetailsLabel={ui.viewDetails} state="standalone" />;
              })()}
            </div>
            <PricePair regular="€120" late="€150" compact {...priceProps} />
          </div>
        </div>
      </article>
      <article class="participation-option participation-option--complete" id="ci-panel-2" role="tabpanel" aria-labelledby="ci-tab-2" data-option-panel="2" hidden>
        <header><span>03</span><div><h3>{copy.ci.optionTitles[2]}</h3><p>{copy.ci.optionMeta[2]}</p></div></header>
        <div class="participation-option__content">
          <p>{copy.ci.optionNotes[2]}</p>
          <div class="participation-option__selection">
            <div>
              <div class="event-choice-grid event-choice-grid--compact">
                {passesShared.eventSlugs.ciMain.map((slug, index) => {
                  const event = eventLink(slug);
                  return <PassEventCard title={event.title} meta={copy.ci.mainMeta} slug={event.slug} accent={event.accent} viewDetailsLabel={ui.viewDetails} state="selectable" inputName="ci-complete-main" checked={index === 0} />;
                })}
              </div>
              {(() => {
                const includedEvent = eventLink('risk-play-flight');
                return <div class="path-includes-card"><PassEventCard title={includedEvent.title} meta={copy.ci.secondMeta} slug={includedEvent.slug} accent={includedEvent.accent} viewDetailsLabel={ui.viewDetails} state="included" status={ui.alsoIncluded} /></div>;
              })()}
            </div>
            <PricePair regular="€240" late="€325" compact {...priceProps} />
          </div>
        </div>
      </article>
      </div>
    </div>
    <p class="context-note"><strong>{copy.ci.title}.</strong> <span class="context-note__desktop">{copy.ci.excluded}</span><span class="context-note__mobile">{ui.ciShortNote}</span></p>
    <footer class="decision-actions">
      <div><a class="passes-action passes-action--primary" data-selection-cta href={passesShared.registrationUrl} rel="noopener" target="_blank">{ui.ciRegisterCtas[0]}</a><a class="passes-action passes-action--text" href="#jams">{copy.ci.ctas[2]} ↓</a></div>
    </footer>
  </section>

  <section class="decision-section path-builder" id="labs" aria-labelledby="labs-title">
    <header class="decision-section__header decision-section__header--text">
      <div>
        <p class="section-kicker">03</p>
        <h2 id="labs-title">{copy.labs.title}</h2>
        <p class="section-lead">{copy.labs.intro}</p>
      </div>
    </header>
    <div class="interactive-choice" data-option-chooser>
      <div class="choice-prompt"><span>01</span><h3>{ui.labsChooserTitle}</h3></div>
      <div class="choice-tabs" role="tablist" aria-label={ui.labsChooserTitle}>
        {copy.labs.optionTitles.map((title: string, index: number) =>
          <button type="button" role="tab" id={`labs-tab-${index}`} aria-controls={`labs-panel-${index}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? '0' : '-1'} data-option-tab={String(index)} data-cta-label={ui.labsRegisterCtas[index]}>
            <span>0{index + 1}</span><strong>{title}</strong><small>{copy.labs.optionMeta[index]}</small>
          </button>
        )}
      </div>
      <select class="choice-select" data-option-select aria-label={ui.labsChooserTitle}>
        {copy.labs.optionTitles.map((title: string, index: number) =>
          <option value={String(index)}>{title}</option>
        )}
      </select>
      <div class="participation-options">
      <article class="participation-option" id="labs-panel-0" role="tabpanel" aria-labelledby="labs-tab-0" data-option-panel="0">
        <header><span>01</span><div><h3>{copy.labs.optionTitles[0]}</h3><p>{copy.labs.optionMeta[0]}</p></div></header>
        <div class="participation-option__content">
          <p>{copy.labs.optionNotes[0]}</p>
          <div class="participation-option__selection">
            <div class="event-choice-grid event-choice-grid--compact">
              {passesShared.eventSlugs.labsMain.map((slug, index) => {
                const event = eventLink(slug);
                return <PassEventCard title={event.title} meta={copy.labs.mainMeta} slug={event.slug} accent={event.accent} viewDetailsLabel={ui.viewDetails} state="selectable" inputName="labs-main" checked={index === 0} />;
              })}
            </div>
            <PricePair regular="€180" late="€230" compact {...priceProps} />
          </div>
        </div>
      </article>
      <article class="participation-option" id="labs-panel-1" role="tabpanel" aria-labelledby="labs-tab-1" data-option-panel="1" hidden>
        <header><span>02</span><div><h3>{copy.labs.optionTitles[1]}</h3><p>{copy.labs.optionMeta[1]}</p></div></header>
        <div class="participation-option__content">
          <p>{copy.labs.optionNotes[1]}</p>
          <div class="participation-option__selection">
            <div class="event-choice-grid event-choice-grid--compact">
              {(() => {
                const event = eventLink('seeing-and-being-seen');
                return <PassEventCard title={event.title} meta={copy.labs.secondMeta} slug={event.slug} accent={event.accent} viewDetailsLabel={ui.viewDetails} state="standalone" />;
              })()}
            </div>
            <PricePair regular="€180" late="€230" compact {...priceProps} />
          </div>
        </div>
      </article>
      <article class="participation-option participation-option--complete" id="labs-panel-2" role="tabpanel" aria-labelledby="labs-tab-2" data-option-panel="2" hidden>
        <header><span>03</span><div><h3>{copy.labs.optionTitles[2]}</h3><p>{copy.labs.optionMeta[2]}</p></div></header>
        <div class="participation-option__content">
          <p>{copy.labs.optionNotes[2]}</p>
          <div class="participation-option__selection">
            <div>
              <div class="event-choice-grid event-choice-grid--compact">
                {passesShared.eventSlugs.labsMain.map((slug, index) => {
                  const event = eventLink(slug);
                  return <PassEventCard title={event.title} meta={copy.labs.mainMeta} slug={event.slug} accent={event.accent} viewDetailsLabel={ui.viewDetails} state="selectable" inputName="labs-complete-main" checked={index === 0} />;
                })}
              </div>
              {(() => {
                const includedEvent = eventLink('seeing-and-being-seen');
                return <div class="path-includes-card"><PassEventCard title={includedEvent.title} meta={copy.labs.secondMeta} slug={includedEvent.slug} accent={includedEvent.accent} viewDetailsLabel={ui.viewDetails} state="included" status={ui.alsoIncluded} /></div>;
              })()}
            </div>
            <PricePair regular="€320" late="€420" compact {...priceProps} />
          </div>
        </div>
      </article>
      </div>
    </div>
    <p class="context-note"><strong>{copy.labs.title}.</strong> <span class="context-note__desktop">{copy.labs.note}</span><span class="context-note__mobile">{ui.labsShortNote}</span></p>
