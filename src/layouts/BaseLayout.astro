---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { getLocalized, type Locale } from '../lib/locales';

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
}

const { lang, title = 'Contact+ 2026', description = '' } = Astro.props;
const nav = [
  { href: `/${lang}/about`, label: { en: 'About', ro: 'Despre Contact+', ru: 'О фестивале' } },
  { href: `/${lang}/program`, label: { en: 'Program Lines', ro: 'Linii de program', ru: 'Линии программы' } },
  { href: `/${lang}/schedule`, label: { en: 'Schedule', ro: 'Orar', ru: 'Расписание' } },
  { href: `/${lang}/artists`, label: { en: 'Teachers & Artists', ro: 'Profesori și artiști', ru: 'Преподаватели и артисты' } },
];
const menuLabel = getLocalized({ en: 'Menu', ro: 'Meniu', ru: 'Меню' }, lang);
const footerLabels = {
  closing: getLocalized({
    en: 'Movement · Contact Improvisation · Performance',
    ro: 'Mișcare · Improvizație de contact · Performance',
    ru: 'Движение · Контактная импровизация · Перформанс',
  }, lang),
  place: getLocalized({
    en: 'Sep 26 — Oct 4 · Chișinău, Moldova',
    ro: '26 septembrie — 4 octombrie · Chișinău, Moldova',
    ru: '26 сентября — 4 октября · Кишинёв, Молдова',
  }, lang),
  prepared: getLocalized({
    en: 'Program overview prepared with care by',
    ro: 'Prezentarea programului pregătită cu grijă de',
    ru: 'Обзор программы бережно подготовил',
  }, lang),
  contacts: getLocalized({ en: 'Contacts', ro: 'Contacte', ru: 'Контакты' }, lang),
  registration: getLocalized({ en: 'Registration', ro: 'Înregistrare', ru: 'Регистрация' }, lang),
  copyright: getLocalized({ en: '© Contact+ 2026', ro: '© Contact+ 2026', ru: '© Contact+ 2026' }, lang),
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '3604684703003850');
      fbq('track', 'PageView');
    </script>
    <script is:inline>
      // Set FBC_ENTRY_ID / FBP_ENTRY_ID to the Google Form's hidden question
      // entry numbers once those questions have been created (see docs/TASKS.md).
      var FBC_ENTRY_ID = '94192550';
      var FBP_ENTRY_ID = '724598572';
      document.addEventListener('click', function (e) {
        var link = e.target.closest('a[href*="1FAIpQLSdkDT1NjKXxzbAg_8dqSLEDnYPstOaBZ8oE6mxqNHkLTUbBlg"]');
        if (!link) return;
        if (window.fbq) {
          fbq('track', 'Lead');
        }
        function appendCookieEntry(entryId, cookieName) {
          if (!entryId) return;
          var match = document.cookie.match(new RegExp('(?:^|;\\s*)' + cookieName + '=([^;]+)'));
          if (match) {
            var separator = link.href.indexOf('?') === -1 ? '?' : '&';
            link.href = link.href + separator + 'entry.' + entryId + '=' + encodeURIComponent(match[1]);
          }
        }
        appendCookieEntry(FBC_ENTRY_ID, '_fbc');
        appendCookieEntry(FBP_ENTRY_ID, '_fbp');
      });
    </script>
    <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=3604684703003850&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body id="top">
    <header class="site-header">
      <a class="brand" href={`/${lang}/about`}>Contact+ 2026</a>
      <nav class="primary-nav" aria-label="Primary navigation">
        {nav.map((item) => <a href={item.href}>{getLocalized(item.label, lang)}</a>)}
      </nav>
      <details class="mobile-nav">
        <summary aria-label={menuLabel}>
          <span>{menuLabel}</span>
          <span class="mobile-nav__chevron" aria-hidden="true"></span>
        </summary>
        <nav class="mobile-nav__menu" aria-label="Primary navigation">
          {nav.map((item) => <a href={item.href}>{getLocalized(item.label, lang)}</a>)}
        </nav>
      </details>
      <LanguageSwitcher lang={lang} />
    </header>
    <slot />
    <footer class="site-footer" aria-label={footerLabels.contacts}>
      <div class="site-footer__inner">
        <div class="site-footer__closing">
          <p class="site-footer__thought">{footerLabels.closing}</p>
        </div>
        <div class="site-footer__next">
          <p class="site-footer__place">{footerLabels.place}</p>
          <nav class="site-footer__links" aria-label={footerLabels.contacts}>
        <a class="site-footer__registration" href="https://docs.google.com/forms/d/e/1FAIpQLSdkDT1NjKXxzbAg_8dqSLEDnYPstOaBZ8oE6mxqNHkLTUbBlg/viewform?usp=header" rel="noopener" target="_blank">{footerLabels.registration}</a>
        <a href="https://www.instagram.com/fest.contactplus/" rel="noopener" target="_blank">Instagram</a>
        <a href="https://www.facebook.com/fest.contactplus" rel="noopener" target="_blank">Facebook</a>
        <a href="mailto:fest.contactplus@gmail.com">fest.contactplus@gmail.com</a>
      </nav>
        </div>
        <div class="site-footer__colophon">
          <p class="site-footer__credit">
            <span>{footerLabels.prepared}</span>
            <a href="https://www.instagram.com/jenia_gheorghiev/" rel="noopener" target="_blank">Jenia Gheorghiev</a>
          </p>
          <p class="site-footer__copyright">{footerLabels.copyright}</p>
        </div>
      </div>
    </footer>
    <a class="back-top" href="#top" aria-label={getLocalized({ en: 'Back to top', ro: 'Înapoi sus', ru: 'Наверх' }, lang)}>↑</a>
  </body>
</html>

<style>
  :root {
    --font-sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-serif: Georgia, "Times New Roman", serif;
    --ink: #24211f;
    --muted: #746d64;
    --soft: #9b9084;
    --paper: #fbfaf7;
    --paper-deep: #f0ebe3;
    --line: #ded6cb;
    --line-strong: #c8bdb0;
    --accent: #805044;
    --accent-muted: #8a655c;
    --page-hero-default-width: 860px;
    --page-hero-wide-width: 1180px;
    --page-hero-title-size: clamp(2.85rem, 5.2vw, 4.65rem);
    --page-hero-wide-title-size: clamp(2.85rem, 4.8vw, 4.45rem);
    --page-hero-title-line-height: 1.03;
    --page-hero-title-letter-spacing: 0;
    --page-hero-title-gap: clamp(16px, 2vw, 20px);
    --page-hero-subtitle-size: clamp(1.04rem, 1.45vw, 1.2rem);
    --page-hero-subtitle-line-height: 1.58;
    --page-hero-subtitle-max-width: 780px;
    --page-hero-context-gap: 18px;
    --page-hero-context-size: 0.78rem;
    --page-hero-bottom-space: clamp(34px, 4.5vw, 52px);
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  :global(body) {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--ink);
    background: var(--paper);
    font-size: 17px;
    line-height: 1.65;
  }

  :global(a) {
    color: inherit;
  }

  :global(::selection) {
    color: var(--paper);
    background: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px clamp(20px, 5vw, 64px);
    border-bottom: 1px solid var(--line);
    background: rgba(251, 250, 247, 0.94);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--accent-muted);
    font-family: var(--font-serif);
    font-size: 1.16rem;
    font-weight: 400;
    letter-spacing: 0;
    text-decoration: none;
  }

  .brand:hover {
    color: var(--ink);
  }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .primary-nav {
    margin-left: auto;
  }

  :global(.language-switcher) {
    flex: 0 0 auto;
  }

  :global(.mobile-nav) {
    display: none;
  }

  .primary-nav a {
    color: var(--muted);
    font-size: 0.95rem;
    text-decoration: none;
  }

  .primary-nav a:hover {
    color: var(--ink);
  }

  :global(.back-top) {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 120;
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(251, 250, 247, 0.94);
    box-shadow: 0 8px 24px rgba(47, 39, 33, 0.08);
    color: var(--accent-muted);
    text-decoration: none;
  }

  :global(.back-top:hover),
  :global(.back-top:focus-visible) {
    border-color: var(--line-strong);
    color: var(--ink);
    outline: 0;
  }

  :global(main) {
    width: min(1040px, calc(100% - 40px));
    margin: 0 auto;
    padding: clamp(48px, 8vw, 92px) 0 clamp(32px, 5vw, 58px);
  }

  :global(.site-footer) {
    width: min(700px, calc(100% - 40px));
    margin: clamp(2px, 0.8vw, 10px) auto clamp(18px, 3vw, 32px);
    padding-top: clamp(14px, 1.6vw, 20px);
    border-top: 1px solid rgba(222, 214, 203, 0.34);
    color: var(--muted);
    text-align: center;
  }

  :global(.site-footer__inner) {
    display: block;
    max-width: 560px;
    margin: 0 auto;
  }

  :global(.site-footer__closing) {
    padding-top: 0;
  }

  :global(.site-footer__thought) {
    max-width: none;
    margin: 0 0 6px;
    color: color-mix(in srgb, var(--soft) 72%, var(--paper));
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 680;
    letter-spacing: 0.11em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  :global(.site-footer__next) {
    padding-top: 0;
  }

  :global(.site-footer__place) {
    margin: 0 0 7px;
    color: color-mix(in srgb, var(--accent-muted) 78%, var(--soft));
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.085em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  :global(.site-footer__registration) {
    display: inline;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--accent-muted);
    font-size: inherit;
    font-weight: 650;
    line-height: inherit;
    text-decoration: none;
  }

  :global(.site-footer__registration:hover) {
    border-color: transparent;
    background: transparent;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: rgba(200, 189, 176, 0.64);
  }

  :global(.site-footer__links),
  :global(.site-footer__credit) {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3px 0;
    margin: 0;
    color: var(--soft);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  :global(.site-footer__links) {
    display: flex;
    justify-content: center;
    max-width: none;
  }

  :global(.site-footer__links a),
  :global(.site-footer__credit span),
  :global(.site-footer__credit a) {
    color: inherit;
    font-weight: 400;
    text-decoration: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.24em;
  }

  :global(.site-footer__links a:hover),
  :global(.site-footer__credit a:hover) {
    color: var(--accent-muted);
    text-decoration: underline;
    text-decoration-color: rgba(200, 189, 176, 0.64);
  }

  :global(.site-footer__links a + a::before) {
    margin-right: 9px;
    color: rgba(155, 144, 132, 0.48);
    content: "·";
  }

  :global(.site-footer__colophon) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: center;
    margin: clamp(10px, 1.7vw, 16px) auto 0;
    padding-top: 0;
    text-align: center;
  }

  :global(.site-footer__copyright) {
    margin: 0;
    color: color-mix(in srgb, var(--soft) 68%, var(--paper));
    font-size: 0.64rem;
    line-height: 1.45;
  }

  :global(.site-footer__credit) {
    display: block;
    color: color-mix(in srgb, var(--soft) 72%, var(--paper));
    font-size: 0.64rem;
    max-width: 520px;
  }

  :global(h1),
  :global(h2),
  :global(h3),
  :global(p) {
    margin-top: 0;
  }

  :global(h1) {
    max-width: var(--page-hero-default-width);
    margin-bottom: var(--page-hero-title-gap);
    font-family: var(--font-serif);
    font-size: var(--page-hero-title-size);
    font-weight: 400;
    line-height: var(--page-hero-title-line-height);
    letter-spacing: var(--page-hero-title-letter-spacing);
  }

  :global(h2) {
    font-size: 1rem;
    letter-spacing: 0.02em;
  }

  :global(.eyebrow),
  :global(.meta) {
    color: var(--accent);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.lead) {
    max-width: var(--page-hero-subtitle-max-width);
    color: var(--muted);
    font-size: var(--page-hero-subtitle-size);
    line-height: var(--page-hero-subtitle-line-height);
  }

  :global(.page-hero) {
    max-width: var(--page-hero-default-width);
    margin-bottom: var(--page-hero-bottom-space);
  }

  :global(.page-hero--wide) {
    max-width: var(--page-hero-wide-width);
  }

  :global(.page-hero h1) {
    max-width: var(--page-hero-default-width);
    margin: 0 0 var(--page-hero-title-gap);
    font-size: var(--page-hero-title-size);
    line-height: var(--page-hero-title-line-height);
    letter-spacing: var(--page-hero-title-letter-spacing);
  }

  :global(.page-hero--wide h1) {
    max-width: var(--page-hero-wide-width);
    font-size: var(--page-hero-wide-title-size);
  }

  :global(.page-hero .lead) {
    max-width: var(--page-hero-subtitle-max-width);
    font-size: var(--page-hero-subtitle-size);
    line-height: var(--page-hero-subtitle-line-height);
  }

  :global(.page-context) {
    margin: var(--page-hero-context-gap) 0 0;
    color: var(--accent-muted);
    font-size: var(--page-hero-context-size);
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    :root {
      --page-hero-title-size: clamp(2.7rem, 11.5vw, 3.55rem);
      --page-hero-wide-title-size: var(--page-hero-title-size);
      --page-hero-subtitle-size: 1.02rem;
      --page-hero-bottom-space: 28px;
      --page-hero-title-gap: 16px;
    }

    :global(.page-hero) {
      margin-inline: auto;
      text-align: center;
    }

    :global(.page-hero h1) {
      max-width: min(100%, 560px);
      margin-inline: auto;
    }

    :global(.page-hero .lead) {
      margin-inline: auto;
      line-height: 1.56;
    }

    :global(.page-context) {
      margin-inline: auto;
    }

    .site-header {
      flex-wrap: wrap;
      gap: 8px 14px;
      padding-block: 13px 12px;
    }

    .primary-nav {
      display: none;
    }

    .primary-nav a {
      font-size: 0.82rem;
    }
  }

  :global(.program-meta) {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.2;
  }

  :global(.program-meta__category) {
    color: var(--accent-muted);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.program-meta__divider) {
    width: 18px;
    height: 1px;
    background: var(--line-strong);
  }

  :global(.program-meta__format) {
    color: var(--muted);
  }

  :global(.program-accent) {
    --program-accent: var(--accent-muted);
    --program-tint: rgba(143, 132, 117, 0.16);
  }

  :global(.program-accent--ci) {
    --program-accent: #738b5f;
    --program-tint: rgba(115, 139, 95, 0.2);
  }

  :global(.program-accent--performance_labs) {
    --program-accent: #a06f42;
    --program-tint: rgba(160, 111, 66, 0.2);
  }

  :global(.program-accent--performances) {
    --program-accent: #8d4f67;
    --program-tint: rgba(141, 79, 103, 0.2);
  }

  :global(.program-accent--family_youth) {
    --program-accent: #62869a;
    --program-tint: rgba(98, 134, 154, 0.2);
  }

  :global(.program-accent--jams_gatherings) {
    --program-accent: #736e96;
    --program-tint: rgba(115, 110, 150, 0.2);
  }

  :global(.program-accent--breaks) {
    --program-accent: #9f917d;
    --program-tint: rgba(159, 145, 125, 0.18);
  }

  :global(.program-accent--org) {
    --program-accent: #958876;
    --program-tint: rgba(149, 136, 118, 0.15);
  }

  :global(.program-accent .program-meta__category),
  :global(.program-accent[data-accent] .program-meta__category) {
    color: var(--program-accent);
  }

  :global(.program-accent .program-meta__divider),
  :global(.program-accent[data-accent] .program-meta__divider) {
    background: color-mix(in srgb, var(--program-accent) 52%, var(--line-strong));
  }

  @media (max-width: 860px) {
    .site-header {
      position: static;
      display: grid;
      grid-template-columns: minmax(0, 1fr) max-content max-content;
      align-items: center;
      gap: 10px;
      padding: 16px 20px 14px;
    }

    .brand {
      grid-column: 1;
      grid-row: 1;
      min-height: 34px;
      font-size: 1.22rem;
    }

    :global(.language-switcher) {
      grid-column: 3;
      grid-row: 1;
      justify-self: end;
    }

    .primary-nav {
      display: none;
    }

    :global(.mobile-nav) {
      position: relative;
      z-index: 20;
      grid-column: 2;
      grid-row: 1;
      display: block;
      justify-self: end;
    }

    :global(.mobile-nav summary) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      min-height: 34px;
      padding: 0 12px 0 14px;
      border: 1px solid color-mix(in srgb, var(--line) 86%, var(--paper));
      border-radius: 999px;
      background: rgba(251, 250, 247, 0.86);
      box-shadow: 0 4px 16px rgba(47, 39, 33, 0.035);
      color: color-mix(in srgb, var(--muted) 78%, var(--ink));
      font-size: 0.76rem;
      font-weight: 650;
      letter-spacing: 0.02em;
      line-height: 1;
      list-style: none;
      cursor: pointer;
      transition: border-color 160ms ease, background 160ms ease, color 160ms ease, box-shadow 160ms ease;
    }

    :global(.mobile-nav summary::-webkit-details-marker) {
      display: none;
    }

    :global(.mobile-nav summary:hover),
    :global(.mobile-nav[open] summary) {
      border-color: var(--line-strong);
      background: color-mix(in srgb, var(--paper-deep) 64%, var(--paper));
      color: var(--ink);
      box-shadow: 0 6px 18px rgba(47, 39, 33, 0.055);
    }

    :global(.mobile-nav summary:focus-visible) {
      outline: 2px solid color-mix(in srgb, var(--accent-muted) 42%, transparent);
      outline-offset: 3px;
    }

    :global(.mobile-nav__chevron) {
      width: 6px;
      height: 6px;
      border-right: 1px solid currentColor;
      border-bottom: 1px solid currentColor;
      opacity: 0.78;
      transform: translateY(-1px) rotate(45deg);
      transition: transform 160ms ease;
    }

    :global(.mobile-nav[open] .mobile-nav__chevron) {
      transform: translateY(1px) rotate(225deg);
    }

    :global(.mobile-nav__menu) {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      display: grid;
      min-width: min(280px, calc(100vw - 40px));
      padding: 8px;
      border: 1px solid var(--line);
      border-radius: 22px;
      background: rgba(251, 250, 247, 0.98);
      box-shadow: 0 18px 42px rgba(33, 31, 29, 0.12);
    }

    :global(.mobile-nav__menu a) {
      display: flex;
      align-items: center;
      min-height: 40px;
      padding: 0 13px;
      border-radius: 14px;
      color: var(--muted);
      font-size: 0.9rem;
      font-weight: 560;
      line-height: 1.15;
      text-decoration: none;
      white-space: nowrap;
    }

    :global(.mobile-nav__menu a:hover),
    :global(.mobile-nav__menu a:focus-visible) {
      background: color-mix(in srgb, var(--paper-deep) 58%, var(--paper));
      color: var(--ink);
      outline: 0;
    }

